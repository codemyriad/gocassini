FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-local-cpu.txt /app/requirements-local-cpu.txt
RUN python3 -m pip install -r /app/requirements-local-cpu.txt

COPY build-meeting-artifact.py /app/build-meeting-artifact.py
COPY cassini_transcriber /app/cassini_transcriber

ENTRYPOINT ["python3", "/app/build-meeting-artifact.py"]
