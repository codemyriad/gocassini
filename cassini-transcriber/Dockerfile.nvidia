FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-local-nvidia.txt /app/requirements-local-nvidia.txt
RUN python3 -m pip install --break-system-packages -r /app/requirements-local-nvidia.txt

COPY build-meeting-artifact.py /app/build-meeting-artifact.py
COPY cassini_transcriber /app/cassini_transcriber

ENTRYPOINT ["python3", "/app/build-meeting-artifact.py"]
