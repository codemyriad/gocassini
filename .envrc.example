# Copy to .envrc (gitignored) and adjust values for your environment.
# If you use direnv, run: direnv allow

# Optional: private cloud room URL for ad-hoc capture runs.
export CALL_URL="https://cloud.example.com/call/<ROOM_TOKEN>"

# Optional: local test stack defaults.
export NEXTCLOUD_URL="http://127.0.0.1:28080"
export NEXTCLOUD_STATUS_URL="${NEXTCLOUD_URL}/status.php"


# Required for `cassini-viewer` demo-data:* scripts.
export DEMO_DATA_URL="https://example.com/cassini-demo-site"

# Optional: source your own local, gitignored setup here (agent config, aliases,
# etc.). Keep such files out of version control. Example:
#   [ -f .envrc.local ] && source_env .envrc.local
