{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cassini.local/spec/cassini-portable-meeting-manifest-v1.schema.json",
  "title": "Cassini Portable Meeting Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "profile",
    "meeting",
    "audio",
    "integrity",
    "speakers",
    "transcript"
  ],
  "properties": {
    "kind": {
      "const": "cassini-portable-meeting"
    },
    "version": {
      "const": 1
    },
    "profile": {
      "const": "ogg-opus"
    },
    "meeting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "createdAtUtc",
        "durationMs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "createdAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "language": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container",
        "codec",
        "sampleRate",
        "channels",
        "sampleCount",
        "durationMs"
      ],
      "properties": {
        "container": {
          "const": "ogg"
        },
        "codec": {
          "const": "opus"
        },
        "sampleRate": {
          "const": 48000
        },
        "channels": {
          "type": "integer",
          "enum": [1, 2]
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matchPolicy",
        "pcmFormat",
        "pcmSha256",
        "sampleRate",
        "channels",
        "sampleCount",
        "durationMs"
      ],
      "properties": {
        "matchPolicy": {
          "const": "exact-pcm"
        },
        "pcmFormat": {
          "const": "s16le"
        },
        "pcmSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "containerSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sampleRate": {
          "const": 48000
        },
        "channels": {
          "type": "integer",
          "enum": [1, 2]
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "speakers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "wordCount",
        "items"
      ],
      "properties": {
        "format": {
          "const": "cassini.words.v1"
        },
        "language": {
          "type": "string"
        },
        "wordCount": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "speaker",
              "startMs",
              "endMs",
              "text"
            ],
            "properties": {
              "speaker": {
                "type": "string",
                "minLength": 1
              },
              "startMs": {
                "type": "integer",
                "minimum": 0
              },
              "endMs": {
                "type": "integer",
                "minimum": 0
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "speechToText": {
          "$ref": "#/$defs/processingStep"
        },
        "readableCleanup": {
          "$ref": "#/$defs/processingStep"
        },
        "displayTranscript": {
          "$ref": "#/$defs/processingStep"
        }
      }
    },
    "readableTranscript": {
      "type": "object"
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "startMs",
          "title"
        ],
        "properties": {
          "startMs": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "object"
    },
    "attachments": {
      "type": "array"
    }
  },
  "$defs": {
    "processingStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "device": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "baseUrl": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    }
  }
}
