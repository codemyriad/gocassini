# check=skip=InvalidDefaultArgInFrom
# BASE_IMAGE intentionally has no default: CI always passes the content-hash
# pinned base ref (--build-arg BASE_IMAGE=…). A bogus default would let a
# forgotten arg build a model-less image silently, so we'd rather fail loudly.
#
# Dockerfile for the CUDA variant of the Cassini ExApp image — thin app layer.
#
# The slow-changing substrate (nvidia/cuda runtime, apt layer, ~2.3GB fp32
# Parakeet model + Silero VAD, sherpa-onnx CUDA native libs) lives in the
# prebuilt base image Dockerfile.exapp.cuda.base, published as
# ghcr.io/codemyriad/gocassini-cuda-base:<hash> and reused across commits (D-375).
# This file builds only the fast, per-commit layers (Go binaries + SPAs) on top.
#
# BASE_IMAGE is required: CI passes the content-hash-pinned base ref. To build
# locally, pass --build-arg BASE_IMAGE=ghcr.io/codemyriad/gocassini-cuda-base:<hash>.
#  - CASSINI_STT_DEVICE=cuda
#  - the operator must invoke recorder runs with --device cuda; CASSINI_STT_DEVICE
#    is the default that surfaces in doctor output.

ARG BASE_IMAGE
ARG FRP_VERSION=0.61.1
ARG CASSINI_BUNDLED_MODEL_ID=parakeet-tdt-0.6b-v3
# Keep in step with Dockerfile.exapp.cuda.base: the GPU image carries only the
# fp32 model, which is what every CUDA quality tier loads. If this image ever
# falls back to CPU decoding, the CPU tiers download on demand (D-704).
ARG CASSINI_BUNDLED_MODELS="parakeet-tdt-0.6b-v3"
ARG FFMPEG_VERSION=latest
ARG FFMPEG_BUILD_JOBS=2

# Match the Ubuntu 22.04 CUDA runtime ABI. FFmpeg stays in this thin layer so
# every application build can pick up the latest stable release without
# rebuilding the multi-gigabyte model/CUDA base.
FROM ubuntu:22.04 AS ffmpeg-builder
ARG FFMPEG_VERSION
ARG FFMPEG_BUILD_JOBS
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl gnupg libopus-dev nasm pkg-config xz-utils \
 && rm -rf /var/lib/apt/lists/*
COPY deployment/ffmpeg /tmp/cassini-ffmpeg-build
RUN FFMPEG_BUILD_JOBS="${FFMPEG_BUILD_JOBS}" \
    /tmp/cassini-ffmpeg-build/build.sh "${FFMPEG_VERSION}" /out/ffmpeg

# ---- Stage: go-builder (recorder + operator, identical to CPU image) ----
FROM golang:1.24-bookworm AS go-builder
WORKDIR /src

COPY cassini-go-recorder/go.mod cassini-go-recorder/go.sum ./cassini-go-recorder/
COPY cassini-operator/go.mod cassini-operator/go.sum ./cassini-operator/
RUN go -C cassini-go-recorder mod download \
 && go -C cassini-operator mod download

COPY cassini-go-recorder ./cassini-go-recorder
COPY cassini-operator ./cassini-operator
RUN set -eux; \
 go -C cassini-go-recorder build -o /out/cassini ./cmd/cassini; \
 go -C cassini-operator build -o /out/cassini-operator ./cmd/cassini-operator
# The CUDA native libs (the complete set the Go binding loads via
# LD_LIBRARY_PATH at runtime) ship in the base image — the app no longer copies
# the CPU placeholder libs from the Go module.

# ---- Stage: web-builder (npm workspace: cassini-app + cassini-viewer; same as CPU image) ----
# See Dockerfile.exapp for the full rationale (D-420 unifies the two web apps;
# cassini-app bundles cassini-viewer via the workspace). pnpm migration: D-499.
FROM node:22-bookworm AS web-builder
WORKDIR /src
COPY package.json ./
COPY cassini-viewer/package.json cassini-viewer/package-lock.json ./cassini-viewer/
COPY cassini-app/package.json cassini-app/package-lock.json ./cassini-app/
RUN npm install
COPY cassini-viewer/ ./cassini-viewer/
COPY cassini-app/ ./cassini-app/
ENV VITE_BASE=./
RUN npm run build:all -w cassini-viewer
RUN npm run build:all -w cassini-app

# ---- Stage: frpc-fetcher (identical to CPU image) ----
FROM debian:bookworm-slim AS frpc-fetcher
ARG FRP_VERSION
ARG TARGETARCH=amd64
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl tar \
 && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
 case "${TARGETARCH:-amd64}" in \
   amd64) frp_arch=amd64 ;; \
   arm64) frp_arch=arm64 ;; \
   arm)   frp_arch=arm ;; \
   *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
 esac; \
 curl -fSL "https://github.com/fatedier/frp/releases/download/v${FRP_VERSION}/frp_${FRP_VERSION}_linux_${frp_arch}.tar.gz" -o /tmp/frp.tgz; \
 mkdir -p /out; \
 tar -xzf /tmp/frp.tgz -C /tmp; \
 cp "/tmp/frp_${FRP_VERSION}_linux_${frp_arch}/frpc" /out/frpc; \
 chmod +x /out/frpc; \
 /out/frpc --version

# ---- Runtime stage: the prebuilt CUDA base + thin per-commit layers ----
FROM ${BASE_IMAGE}
ARG CASSINI_BUNDLED_MODELS
ARG CASSINI_BUNDLED_MODEL_ID
ARG FFMPEG_VERSION
LABEL io.gocassini.ffmpeg.requested-version=${FFMPEG_VERSION}
ENV CASSINI_BUNDLED_MODELS="${CASSINI_BUNDLED_MODELS}"
ENV CASSINI_STT_MODEL=${CASSINI_BUNDLED_MODEL_ID}

WORKDIR /var/lib/cassini-operator
# CASSINI_OPERATOR_{DB_PATH,WORK_ROOT,SITE_ROOT} are fallbacks for runs
# without AppAPI (smoke tests, e2e harness, plain docker run). Under an
# AppAPI deploy the operator treats these exact values as "not explicitly
# configured" and redirects them under APP_PERSISTENT_STORAGE — keep them
# in sync with the imageDefault* constants in
# cassini-operator/internal/operator/exapp.go.
ENV CASSINI_BIN=/usr/local/bin/cassini \
    CASSINI_LIB_DIR=/opt/cassini/lib \
    LD_LIBRARY_PATH=/opt/cassini/lib \
    CASSINI_EXPORTER_RUNNER=/opt/cassini/cassini-publisher/bin/export-static-meetings.sh \
    CASSINI_OPERATOR_DB_PATH=/var/lib/cassini-operator/jobs.sqlite3 \
    CASSINI_OPERATOR_WORK_ROOT=/var/lib/cassini-operator/jobs \
    CASSINI_OPERATOR_SITE_ROOT=/srv/cassini-site/published \
    CASSINI_CACHE_ROOT=/opt/cassini/cache \
    CASSINI_VIEWER_DIST=/opt/cassini/cassini-app/dist \
    TMPDIR=/var/lib/cassini-operator/tmp \
    APP_HOST=0.0.0.0 \
    APP_PORT=8080 \
    CASSINI_APPAPI_REQUIRED=true \
    CASSINI_STT_CUDA_CAPABLE=1 \
    CASSINI_STT_DEVICE=cuda \
    CASSINI_BUNDLED_MODEL_ROOT=/opt/cassini/cache
ENV PATH=/opt/cassini/ffmpeg/bin:${PATH}

# AppAPI deploys inject only APP_*/HP_*/NEXTCLOUD_URL (see app_api
# DockerActions::buildDeployEnvs) — never CASSINI_*. Bake the base path the
# manifest route ACLs (^operator\/...) and the operator client assume,
# or the operator falls back to BasePath "/" and every /operator/* request
# 404s in a real install.
ENV CASSINI_OPERATOR_BASE_PATH=/operator

COPY --from=go-builder /out/cassini /usr/local/bin/cassini
COPY --from=go-builder /out/cassini-operator /usr/local/bin/cassini-operator
COPY --from=frpc-fetcher /out/frpc /usr/local/bin/frpc
COPY --from=ffmpeg-builder /out/ffmpeg /opt/cassini/ffmpeg
COPY cassini-publisher/bin/export-static-meetings.sh /opt/cassini/cassini-publisher/bin/export-static-meetings.sh
COPY cassini-viewer/package.json /opt/cassini/cassini-viewer/package.json
COPY cassini-viewer/scripts/export-static-meetings.mjs /opt/cassini/cassini-viewer/scripts/export-static-meetings.mjs
COPY --from=web-builder /src/cassini-viewer/dist /opt/cassini/cassini-viewer/dist
COPY --from=web-builder /src/cassini-app/dist /opt/cassini/cassini-app/dist
COPY deployment/exapp-start.sh /usr/local/bin/cassini-exapp-entrypoint.sh
COPY deployment/exapp-healthcheck.sh /usr/local/bin/healthcheck.sh

# The base already ships /opt/cassini/lib; refresh the linker cache for it and
# finalize the thin app artifacts.
RUN printf '%s\n' /opt/cassini/lib /opt/cassini/ffmpeg/lib > /etc/ld.so.conf.d/cassini.conf \
 && ldconfig \
 && chmod +x \
   /usr/local/bin/cassini \
   /usr/local/bin/cassini-operator \
   /usr/local/bin/frpc \
   /usr/local/bin/cassini-exapp-entrypoint.sh \
   /usr/local/bin/healthcheck.sh \
   /opt/cassini/cassini-publisher/bin/export-static-meetings.sh \
 && mkdir -p \
   /var/lib/cassini-operator \
   /var/lib/cassini-operator/jobs \
   /var/lib/cassini-operator/tmp \
   /srv/cassini-site/published

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["/usr/local/bin/healthcheck.sh"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/cassini-exapp-entrypoint.sh"]
