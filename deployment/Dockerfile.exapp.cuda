# Dockerfile for the CUDA variant of the Cassini ExApp image.
#
# Same layout as Dockerfile.exapp (CPU variant) but:
#  - runtime base is nvidia/cuda:<pinned>-cudnn-runtime-ubuntu22.04 (Ubuntu 22.04
#    so the prebuilt sherpa-onnx CUDA artifact's libstdc++ is satisfied)
#  - native libs come from sherpa-onnx-v1.13.1-cuda-12.x-cudnn-9.x-linux-x64-gpu
#    (which ships libonnxruntime_providers_cuda.so + a CUDA-built
#    libsherpa-onnx-c-api.so that the Go binding picks up via LD_LIBRARY_PATH)
#  - bundled model is the v3 fp32 Parakeet (encoder.onnx, not encoder.int8.onnx)
#  - CASSINI_STT_DEVICE=cuda
#  - the operator must invoke recorder runs with --device cuda; CASSINI_STT_DEVICE
#    is the default that surfaces in doctor output.

ARG FRP_VERSION=0.61.1
ARG CASSINI_BUNDLED_MODEL_ID=parakeet-tdt-0.6b-v3
ARG CASSINI_BUNDLED_MODEL_URL=https://assets.gocassini.codemyriad.io/sherpa-onnx-nemo-parakeet-tdt-0.6b-v3.tar.bz2
ARG SHERPA_CUDA_VERSION=v1.13.1
ARG SHERPA_CUDA_URL=https://github.com/k2-fsa/sherpa-onnx/releases/download/v1.13.1/sherpa-onnx-v1.13.1-cuda-12.x-cudnn-9.x-linux-x64-gpu.tar.bz2

# ---- Stage: model-fetcher (downloads + extracts the fp32 model) ----
FROM debian:bookworm-slim AS model-fetcher
ARG CASSINI_BUNDLED_MODEL_ID
ARG CASSINI_BUNDLED_MODEL_URL
ARG SILERO_VAD_URL=https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/silero_vad.onnx
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl tar bzip2 \
 && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
 model_dir="/out/models/${CASSINI_BUNDLED_MODEL_ID}"; \
 mkdir -p "$model_dir" /out/vad /tmp/extract; \
 curl -fSL "${CASSINI_BUNDLED_MODEL_URL}" -o /tmp/model.tar.bz2; \
 tar -xjf /tmp/model.tar.bz2 -C /tmp/extract; \
 # Archive top-level may be "sherpa-onnx-*" (int8 repacks) or just the model
 # id (fp32 release on assets.gocassini.codemyriad.io). Don't rely on name.
 src_dir=$(find /tmp/extract -mindepth 1 -maxdepth 1 -type d | head -n1); \
 test -n "$src_dir" || (echo "no extracted dir under /tmp/extract:" >&2; ls /tmp/extract >&2; exit 1); \
 # Required core files (must exist).
 for f in encoder.onnx decoder.onnx joiner.onnx tokens.txt; do \
   test -f "$src_dir/$f" || (echo "missing $f in extracted archive" >&2; ls "$src_dir" >&2; exit 1); \
   cp "$src_dir/$f" "$model_dir/"; \
 done; \
 # Optional sidecars present in fp32 builds (external onnx weights, BPE vocab
 # for some tokenizers). Copy if present — sherpa will fail to load the encoder
 # without encoder.weights when the onnx references it via external_data.
 for f in encoder.weights bpe.vocab; do \
   if [ -f "$src_dir/$f" ]; then \
     cp "$src_dir/$f" "$model_dir/"; \
   fi; \
 done; \
 rm -rf /tmp/model.tar.bz2 /tmp/extract; \
 printf '%s\n' \
   "NeMo Parakeet TDT 0.6B v3 fp32 (sherpa-onnx repack, CUDA variant)" \
   "Source: ${CASSINI_BUNDLED_MODEL_URL}" \
   "License: cc-by-4.0 (NVIDIA Parakeet, https://huggingface.co/nvidia/parakeet-tdt-0.6b-v3)" \
   "Bundled in: ghcr.io/codemyriad/gocassini (CUDA variant)" \
   > "$model_dir/NOTICE"; \
 # Bundle Silero VAD alongside the STT model so the recorder doesn't dial out.
 curl -fSL "${SILERO_VAD_URL}" -o /out/vad/silero_vad.onnx; \
 ls -la "$model_dir/" /out/vad/

# ---- Stage: sherpa-cuda-fetcher (CUDA-enabled native libs) ----
FROM debian:bookworm-slim AS sherpa-cuda-fetcher
ARG SHERPA_CUDA_URL
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl tar bzip2 \
 && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
 curl -fSL "${SHERPA_CUDA_URL}" -o /tmp/sherpa.tar.bz2; \
 mkdir -p /tmp/sherpa-extract; \
 tar -xjf /tmp/sherpa.tar.bz2 -C /tmp/sherpa-extract; \
 src_dir=$(find /tmp/sherpa-extract -maxdepth 1 -type d -name 'sherpa-onnx-*' | head -n1); \
 test -n "$src_dir" || (echo "no extracted dir" >&2; ls /tmp/sherpa-extract >&2; exit 1); \
 mkdir -p /out/lib; \
 # The four .so files the Go binding + onnxruntime need at runtime. The CPU
 # libs shipped with the Go module are overwritten by these later in the
 # runtime stage's COPY ordering.
 cp "$src_dir/lib/libsherpa-onnx-c-api.so"            /out/lib/; \
 cp "$src_dir/lib/libonnxruntime.so"                  /out/lib/; \
 cp "$src_dir/lib/libonnxruntime_providers_cuda.so"   /out/lib/; \
 cp "$src_dir/lib/libonnxruntime_providers_shared.so" /out/lib/; \
 rm -rf /tmp/sherpa.tar.bz2 /tmp/sherpa-extract; \
 ls -la /out/lib/

# ---- Stage: go-builder (recorder + operator, identical to CPU image) ----
FROM golang:1.24-bookworm AS go-builder
WORKDIR /src

COPY cassini-go-recorder/go.mod cassini-go-recorder/go.sum ./cassini-go-recorder/
COPY cassini-operator/go.mod cassini-operator/go.sum ./cassini-operator/
RUN go -C cassini-go-recorder mod download \
 && go -C cassini-operator mod download

COPY cassini-go-recorder ./cassini-go-recorder
COPY cassini-operator ./cassini-operator
RUN set -eux; \
 mkdir -p /out/lib; \
 go -C cassini-go-recorder build -o /out/cassini ./cmd/cassini; \
 go -C cassini-operator build -o /out/cassini-operator ./cmd/cassini-operator
# Native libs (CPU variants) come from the Go module's lib/ dir; we still
# copy them so the image filesystem has SOMETHING, then the CUDA fetcher
# overwrites them in the runtime stage.
RUN set -eux; \
 sherpa_root="$(go list -C cassini-go-recorder -m -f '{{.Dir}}' github.com/k2-fsa/sherpa-onnx-go-linux)"; \
 cp "$sherpa_root/lib/x86_64-unknown-linux-gnu/libsherpa-onnx-c-api.so" /out/lib/; \
 cp "$sherpa_root/lib/x86_64-unknown-linux-gnu/libonnxruntime.so"        /out/lib/

# ---- Stage: viewer-builder + control-panel-builder (identical to CPU image) ----
FROM node:22-bookworm AS viewer-builder
WORKDIR /src/cassini-viewer
COPY cassini-viewer/package.json cassini-viewer/package-lock.json ./
RUN npm ci
COPY cassini-viewer/ ./
ENV VITE_BASE=/viewer/
ENV VITE_PUBLISHED_BASE=/published
RUN npm run build

FROM node:22-bookworm AS control-panel-builder
WORKDIR /src/cassini-control-panel
COPY cassini-control-panel/package.json cassini-control-panel/package-lock.json ./
RUN npm ci
COPY cassini-control-panel/ ./
ENV VITE_BASE=/control-panel/
ENV CASSINI_OPERATOR_BASE_PATH=/operator
RUN npm run build

# ---- Stage: frpc-fetcher (identical to CPU image) ----
FROM debian:bookworm-slim AS frpc-fetcher
ARG FRP_VERSION
ARG TARGETARCH=amd64
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl tar \
 && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
 case "${TARGETARCH:-amd64}" in \
   amd64) frp_arch=amd64 ;; \
   arm64) frp_arch=arm64 ;; \
   arm)   frp_arch=arm ;; \
   *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
 esac; \
 curl -fSL "https://github.com/fatedier/frp/releases/download/v${FRP_VERSION}/frp_${FRP_VERSION}_linux_${frp_arch}.tar.gz" -o /tmp/frp.tgz; \
 mkdir -p /out; \
 tar -xzf /tmp/frp.tgz -C /tmp; \
 cp "/tmp/frp_${FRP_VERSION}_linux_${frp_arch}/frpc" /out/frpc; \
 chmod +x /out/frpc; \
 /out/frpc --version

# ---- Runtime stage: nvidia/cuda base + node + ffmpeg ----
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
ARG CASSINI_BUNDLED_MODEL_ID
ENV CASSINI_STT_MODEL=${CASSINI_BUNDLED_MODEL_ID}

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash ca-certificates curl ffmpeg tini gnupg \
 && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /var/lib/cassini-operator
# CASSINI_OPERATOR_{DB_PATH,WORK_ROOT,SITE_ROOT} are fallbacks for runs
# without AppAPI (smoke tests, e2e harness, plain docker run). Under an
# AppAPI deploy the operator treats these exact values as "not explicitly
# configured" and redirects them under APP_PERSISTENT_STORAGE — keep them
# in sync with the imageDefault* constants in
# cassini-operator/internal/operator/exapp.go.
ENV CASSINI_BIN=/usr/local/bin/cassini \
    CASSINI_LIB_DIR=/opt/cassini/lib \
    LD_LIBRARY_PATH=/opt/cassini/lib \
    CASSINI_EXPORTER_RUNNER=/opt/cassini/cassini-publisher/bin/export-static-meetings.sh \
    CASSINI_OPERATOR_DB_PATH=/var/lib/cassini-operator/jobs.sqlite3 \
    CASSINI_OPERATOR_WORK_ROOT=/var/lib/cassini-operator/jobs \
    CASSINI_OPERATOR_SITE_ROOT=/srv/cassini-site/published \
    CASSINI_CACHE_ROOT=/opt/cassini/cache \
    CASSINI_CONTROL_PANEL_DIST=/opt/cassini/cassini-control-panel/dist \
    CASSINI_VIEWER_DIST=/opt/cassini/cassini-viewer/dist \
    TMPDIR=/var/lib/cassini-operator/tmp \
    APP_HOST=0.0.0.0 \
    APP_PORT=8080 \
    CASSINI_APPAPI_REQUIRED=true \
    CASSINI_STT_DEVICE=cuda \
    CASSINI_DISALLOW_MODEL_DOWNLOAD=1

# AppAPI deploys inject only APP_*/HP_*/NEXTCLOUD_URL (see app_api
# DockerActions::buildDeployEnvs) — never CASSINI_*. Bake the base path the
# manifest route ACLs (^operator\/...) and the control-panel bundle assume,
# or the operator falls back to BasePath "/" and every /operator/* request
# 404s in a real install.
ENV CASSINI_OPERATOR_BASE_PATH=/operator

COPY --from=go-builder /out/cassini /usr/local/bin/cassini
COPY --from=go-builder /out/cassini-operator /usr/local/bin/cassini-operator
# CPU libs first…
COPY --from=go-builder /out/lib /opt/cassini/lib
# …then the CUDA variants overwrite libsherpa-onnx-c-api.so + libonnxruntime.so
# and add the CUDA provider libs alongside.
COPY --from=sherpa-cuda-fetcher /out/lib /opt/cassini/lib
COPY --from=frpc-fetcher /out/frpc /usr/local/bin/frpc
COPY --from=model-fetcher /out /opt/cassini/cache
COPY cassini-publisher/bin/export-static-meetings.sh /opt/cassini/cassini-publisher/bin/export-static-meetings.sh
COPY cassini-viewer/package.json /opt/cassini/cassini-viewer/package.json
COPY cassini-viewer/scripts/export-static-meetings.mjs /opt/cassini/cassini-viewer/scripts/export-static-meetings.mjs
COPY --from=viewer-builder /src/cassini-viewer/dist /opt/cassini/cassini-viewer/dist
COPY --from=control-panel-builder /src/cassini-control-panel/dist /opt/cassini/cassini-control-panel/dist
COPY deployment/exapp-start.sh /usr/local/bin/cassini-exapp-entrypoint.sh
COPY deployment/exapp-healthcheck.sh /usr/local/bin/healthcheck.sh

RUN printf '%s\n' /opt/cassini/lib > /etc/ld.so.conf.d/cassini.conf \
 && ldconfig \
 && chmod +x \
   /usr/local/bin/cassini \
   /usr/local/bin/cassini-operator \
   /usr/local/bin/frpc \
   /usr/local/bin/cassini-exapp-entrypoint.sh \
   /usr/local/bin/healthcheck.sh \
   /opt/cassini/cassini-publisher/bin/export-static-meetings.sh \
 && mkdir -p \
   /var/lib/cassini-operator \
   /var/lib/cassini-operator/jobs \
   /var/lib/cassini-operator/tmp \
   /srv/cassini-site/published

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["/usr/local/bin/healthcheck.sh"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/cassini-exapp-entrypoint.sh"]
