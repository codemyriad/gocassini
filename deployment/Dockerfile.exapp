# Dockerfile for the Nextcloud ExApp build of Cassini.
#
# Layout shipped to the container:
#   /usr/local/bin/cassini                         recorder CLI (Go)
#   /usr/local/bin/cassini-operator                operator HTTP server (Go)
#   /usr/local/bin/frpc                            FRP client for the HaRP tunnel
#   /usr/local/bin/cassini-exapp-entrypoint.sh     writes frpc.toml, launches frpc, exec operator
#   /usr/local/bin/healthcheck.sh                  liveness probe
#   /opt/cassini/lib                               sherpa-onnx native libs
#   /opt/cassini/cassini-app/dist                  Cassini SPA build (served /viewer + /ui/viewer.*)
#   /opt/cassini/cassini-viewer/dist               viewing-layer build (only for `cassini publish --rebuild-viewer`)
#   /opt/cassini/cassini-publisher/bin/...         Node publish runner (unchanged from operator image)
#
# Publish is lightweight by default (D-531): `cassini publish` writes
# catalog.json + meetings/ into the site root and does NOT embed the viewer
# shell. The shell is served from CASSINI_VIEWER_DIST (cassini-app/dist) by the
# operator's viewerHandler, so no CASSINI_PUBLISH_REBUILD_VIEWER is set here.

ARG FRP_VERSION=0.61.1
ARG FFMPEG_VERSION=latest
ARG FFMPEG_BUILD_JOBS=2

# The model this image bakes: the one its default quality tier loads. A CPU host
# runs "balanced" by default, so the portable image carries the 0.6B int8 model
# and nothing else. Fast and Best download once into the persistent model cache
# when an administrator selects them (D-704), which keeps this image small
# without removing a tier. The URLs and per-model file lists live in
# deployment/models/fetch-models.sh.
ARG CASSINI_BUNDLED_MODELS="parakeet-tdt-0.6b-v3-int8"
# The CASSINI_STT_MODEL default baked into the runtime stage, for direct CLI use
# inside the container. Operator-managed builds never see it: the operator
# strips CASSINI_STT_MODEL from the child env so the quality tier decides.
ARG CASSINI_BUNDLED_MODEL_ID=parakeet-tdt-0.6b-v3-int8

# "latest" is an uncached-build fallback. Repository build entry points resolve
# the newest stable version before invoking Docker and pass the concrete value,
# so a newly published release invalidates this layer without a source pin.
# The image records the selected version in BUILDINFO and smoke tests gate
# capabilities instead of naming a fixed release.
FROM debian:bookworm-slim AS ffmpeg-builder
ARG FFMPEG_VERSION
ARG FFMPEG_BUILD_JOBS
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl gnupg libopus-dev nasm pkg-config xz-utils \
 && rm -rf /var/lib/apt/lists/*
COPY deployment/ffmpeg /tmp/cassini-ffmpeg-build
RUN FFMPEG_BUILD_JOBS="${FFMPEG_BUILD_JOBS}" \
    /tmp/cassini-ffmpeg-build/build.sh "${FFMPEG_VERSION}" /out/ffmpeg

FROM debian:bookworm-slim AS model-fetcher
ARG CASSINI_BUNDLED_MODELS
ARG SILERO_VAD_URL=https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/silero_vad.onnx
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl tar bzip2 \
 && rm -rf /var/lib/apt/lists/*
COPY deployment/models /tmp/cassini-models
# Download + extract in a single layer so the archives never land in the final
# image's filesystem. Files under /out/models/<id>/ get COPY'd into the runtime
# stage as their own layer.
RUN set -eux; \
 /tmp/cassini-models/fetch-models.sh /out ${CASSINI_BUNDLED_MODELS}; \
 mkdir -p /out/vad; \
 # Bundle the Silero VAD model alongside the STT models (~630 KB) so the
 # recorder doesn't need to dial out at first run.
 curl -fSL "${SILERO_VAD_URL}" -o /out/vad/silero_vad.onnx; \
 ls -la /out/models /out/vad/

FROM golang:1.24-bookworm AS go-builder
WORKDIR /src

COPY cassini-go-recorder/go.mod cassini-go-recorder/go.sum ./cassini-go-recorder/
COPY cassini-operator/go.mod cassini-operator/go.sum ./cassini-operator/
RUN go -C cassini-go-recorder mod download \
 && go -C cassini-operator mod download

COPY cassini-go-recorder ./cassini-go-recorder
COPY cassini-operator ./cassini-operator
RUN set -eux; \
 mkdir -p /out/lib; \
 go -C cassini-go-recorder build -o /out/cassini ./cmd/cassini; \
 go -C cassini-operator build -o /out/cassini-operator ./cmd/cassini-operator; \
 sherpa_root="$(go list -C cassini-go-recorder -m -f '{{.Dir}}' github.com/k2-fsa/sherpa-onnx-go-linux)"; \
 case "$(go env GOARCH)" in \
   amd64) sherpa_triplet='x86_64-unknown-linux-gnu' ;; \
   arm64) sherpa_triplet='aarch64-unknown-linux-gnu' ;; \
   arm) sherpa_triplet='arm-unknown-linux-gnueabihf' ;; \
   *) echo "unsupported GOARCH: $(go env GOARCH)" >&2; exit 1 ;; \
 esac; \
 cp "$sherpa_root/lib/$sherpa_triplet/libsherpa-onnx-c-api.so" /out/lib/; \
 cp "$sherpa_root/lib/$sherpa_triplet/libonnxruntime.so" /out/lib/

# Web workspace builder (D-420): cassini-app (the in-NC shell) consumes
# cassini-viewer (the viewing layer) via the npm workspace, so both install
# together and cassini-app's build bundles the viewer's source into one IIFE.
# (pnpm migration tracked in D-499.)
FROM node:22-bookworm AS web-builder
WORKDIR /src
# Manifests first for install-layer caching. The root lockfile pins the whole
# workspace and `npm ci` installs exactly what it says. Resolving fresh with
# `npm install` made every build depend on the registry's state of the day:
# on 2026-09-03 that tripped npm 10.9's "Cannot read properties of null
# (reading 'edgesOut')" on an unchanged tree.
COPY package.json package-lock.json ./
COPY cassini-viewer/package.json cassini-viewer/package-lock.json ./cassini-viewer/
COPY cassini-app/package.json cassini-app/package-lock.json ./cassini-app/
RUN npm ci
COPY cassini-viewer/ ./cassini-viewer/
COPY cassini-app/ ./cassini-app/
# VITE_BASE=./ keeps standalone asset URLs relative (served at /viewer/ by the
# operator's SPA handler). Embedded builds resolve their proxy base at runtime
# from window.__CASSINI_VIEWER_BASE__ (src/embedded.ts), so no bake-in there.
ENV VITE_BASE=./
# cassini-viewer's own dist feeds the publisher's static-export tooling.
RUN npm run build:all -w cassini-viewer
# cassini-app: build:all emits the standalone dist/ (served at /viewer) AND the
# embedded dist/embedded/{embedded.js,embedded.css} — the single
# /ui/viewer.{js,css} the operator serves. It bundles cassini-viewer via the
# workspace.
RUN npm run build:all -w cassini-app

FROM debian:bookworm-slim AS frpc-fetcher
ARG FRP_VERSION
ARG TARGETARCH=amd64
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl tar \
 && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
 case "${TARGETARCH:-amd64}" in \
   amd64) frp_arch=amd64 ;; \
   arm64) frp_arch=arm64 ;; \
   arm)   frp_arch=arm ;; \
   *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
 esac; \
 curl -fSL "https://github.com/fatedier/frp/releases/download/v${FRP_VERSION}/frp_${FRP_VERSION}_linux_${frp_arch}.tar.gz" -o /tmp/frp.tgz; \
 mkdir -p /out; \
 tar -xzf /tmp/frp.tgz -C /tmp; \
 cp "/tmp/frp_${FRP_VERSION}_linux_${frp_arch}/frpc" /out/frpc; \
 chmod +x /out/frpc; \
 /out/frpc --version

FROM node:22-bookworm-slim
ARG CASSINI_BUNDLED_MODELS
ARG CASSINI_BUNDLED_MODEL_ID
ARG FFMPEG_VERSION
LABEL io.gocassini.ffmpeg.requested-version=${FFMPEG_VERSION}
# The models this image actually carries, for tests and diagnostics: the runtime
# forbids downloads, so this is exactly the set of quality tiers it can execute.
ENV CASSINI_BUNDLED_MODELS="${CASSINI_BUNDLED_MODELS}"
ENV CASSINI_STT_MODEL=${CASSINI_BUNDLED_MODEL_ID}
RUN apt-get update \
 && apt-get install -y --no-install-recommends bash ca-certificates curl libopus0 tini \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /var/lib/cassini-operator
# CASSINI_OPERATOR_{DB_PATH,WORK_ROOT,SITE_ROOT} are fallbacks for runs
# without AppAPI (smoke tests, e2e harness, plain docker run). Under an
# AppAPI deploy the operator treats these exact values as "not explicitly
# configured" and redirects them under APP_PERSISTENT_STORAGE — keep them
# in sync with the imageDefault* constants in
# cassini-operator/internal/operator/exapp.go.
ENV CASSINI_BIN=/usr/local/bin/cassini \
    CASSINI_LIB_DIR=/opt/cassini/lib \
    LD_LIBRARY_PATH=/opt/cassini/lib \
    CASSINI_EXPORTER_RUNNER=/opt/cassini/cassini-publisher/bin/export-static-meetings.sh \
    CASSINI_OPERATOR_DB_PATH=/var/lib/cassini-operator/jobs.sqlite3 \
    CASSINI_OPERATOR_WORK_ROOT=/var/lib/cassini-operator/jobs \
    CASSINI_OPERATOR_SITE_ROOT=/srv/cassini-site/published \
    CASSINI_CACHE_ROOT=/opt/cassini/cache \
    CASSINI_VIEWER_DIST=/opt/cassini/cassini-app/dist \
    TMPDIR=/var/lib/cassini-operator/tmp \
    APP_HOST=0.0.0.0 \
    APP_PORT=8080 \
    CASSINI_APPAPI_REQUIRED=true \
    CASSINI_STT_CUDA_CAPABLE=0 \
    CASSINI_STT_DEVICE=cpu \
    CASSINI_BUNDLED_MODEL_ROOT=/opt/cassini/cache
ENV PATH=/opt/cassini/ffmpeg/bin:${PATH}

# AppAPI deploys inject only APP_*/HP_*/NEXTCLOUD_URL (see app_api
# DockerActions::buildDeployEnvs) — never CASSINI_*. Bake the base path the
# manifest route ACLs (^operator\/...) and the operator client assume, or the
# operator falls back to BasePath "/" and every /operator/* request 404s in a
# real install.
ENV CASSINI_OPERATOR_BASE_PATH=/operator

COPY --from=go-builder /out/cassini /usr/local/bin/cassini
COPY --from=go-builder /out/cassini-operator /usr/local/bin/cassini-operator
COPY --from=go-builder /out/lib /opt/cassini/lib
COPY --from=ffmpeg-builder /out/ffmpeg /opt/cassini/ffmpeg
COPY --from=frpc-fetcher /out/frpc /usr/local/bin/frpc
# Bundled default STT model + Silero VAD (CPU variant). Lives outside
# /var/lib/cassini-operator so the AppAPI/compose persistent volume mount
# doesn't mask it at runtime. /out is laid out as the cache root:
#   /opt/cassini/cache/models/<id>/...
#   /opt/cassini/cache/vad/silero_vad.onnx
COPY --from=model-fetcher /out /opt/cassini/cache
COPY cassini-publisher/bin/export-static-meetings.sh /opt/cassini/cassini-publisher/bin/export-static-meetings.sh
COPY cassini-viewer/package.json /opt/cassini/cassini-viewer/package.json
COPY cassini-viewer/scripts/export-static-meetings.mjs /opt/cassini/cassini-viewer/scripts/export-static-meetings.mjs
COPY --from=web-builder /src/cassini-viewer/dist /opt/cassini/cassini-viewer/dist
COPY --from=web-builder /src/cassini-app/dist /opt/cassini/cassini-app/dist
COPY deployment/exapp-start.sh /usr/local/bin/cassini-exapp-entrypoint.sh
COPY deployment/exapp-healthcheck.sh /usr/local/bin/healthcheck.sh

RUN printf '%s\n' /opt/cassini/lib /opt/cassini/ffmpeg/lib > /etc/ld.so.conf.d/cassini.conf \
 && ldconfig \
 && chmod +x \
   /usr/local/bin/cassini \
   /usr/local/bin/cassini-operator \
   /usr/local/bin/frpc \
   /usr/local/bin/cassini-exapp-entrypoint.sh \
   /usr/local/bin/healthcheck.sh \
   /opt/cassini/cassini-publisher/bin/export-static-meetings.sh \
 && mkdir -p \
   /var/lib/cassini-operator \
   /var/lib/cassini-operator/jobs \
   /var/lib/cassini-operator/tmp \
   /srv/cassini-site/published

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["/usr/local/bin/healthcheck.sh"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/cassini-exapp-entrypoint.sh"]
