# cassini-exapp-backup config (D-568). NO SECRETS HERE.
# rclone credentials live in /root/.config/rclone/rclone.conf (root-only, 0600).
SRC=<set-on-target-host>
# rclone remote name. `r2` is the account-wide Cloudflare R2 remote; swap this for
# a bucket-scoped remote once a token scoped to cassini-exapp-backups exists.
RCLONE_REMOTE=<set-on-target-host>
BUCKET=<set-on-target-host>
PREFIX=<set-on-target-host>
