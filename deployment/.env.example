# Copy this file to .env and adjust as needed:
#   cp .env.example .env
# Every variable has a working default in compose.yml, so .env is optional
# unless you set the Talk recording/signaling secrets or change ports.

# Host address the published ports bind to. Defaults to loopback because the
# operator job API is unauthenticated; see "Network exposure" in README.md
# before exposing it more widely.
# CASSINI_PUBLISH_ADDRESS=127.0.0.1

CASSINI_OPERATOR_PORT=4000
CASSINI_VIEWER_PORT=8765
CASSINI_OPERATOR_BASE_PATH=/
CASSINI_MAX_RECORD_WORKERS=1
CASSINI_MAX_BUILD_WORKERS=1

# Shared secret between Nextcloud Talk and the operator's recording backend.
# Generate a fresh value per deployment (never reuse a committed or published
# one):
#   openssl rand -hex 32
CASSINI_TALK_RECORDING_SECRET=

# Shared secret for the standalone Talk signaling server's internal HPB auth.
# Set this to the signaling server `internalsecret` when using hpb-internal
# capture mode.
CASSINI_TALK_SIGNALING_INTERNAL_SECRET=

CASSINI_TALK_BACKEND_URL=http://host.docker.internal:28080

# Optional bind-mount overrides. Leave unset to use the default named volumes.
# CASSINI_OPERATOR_STATE_STORAGE=/absolute/path/to/cassini-operator-state
# CASSINI_PUBLISHED_SITE_STORAGE=/absolute/path/to/cassini-published-site-storage

# Optional operator capability pass-through.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=
# LLM_BASE_URL=
# LLM_MODEL=
# SUMMARY_MODEL=
# CASSINI_LLM_TIMEOUT_SEC=
# CASSINI_LLM_MAX_TOKENS=
# CASSINI_SUMMARY_DISABLED=
# CASSINI_READABLE_DISABLED=
# CASSINI_READABLE_STRICT_BATCHES=
