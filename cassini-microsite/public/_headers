# Response headers for the static assets this site serves.
#
# Cloudflare Workers Static Assets reads this file from the assets directory
# (Astro copies public/ into dist/ verbatim). It does NOT apply to responses a
# Worker generates — this site generates none, so every rule below takes effect.

# The public embed (D-775). A page on another origin loads viewer.js with a
# plain <script src>, which needs no CORS at all; what needs it is the fetch the
# script then makes for the recording, which is cross-origin whenever the
# embedding page is not this site. Allowing it on the assets too costs nothing
# and lets a page preload them.
/embed/*
  Access-Control-Allow-Origin: *

# The recording behind the conference page, for the same reason: it is fetched
# by script, so an embed on another origin cannot read it without this.
/nextcloud-conf-2026/*
  Access-Control-Allow-Origin: *
  Access-Control-Expose-Headers: Content-Range, Content-Length

# Firefox sniffs the Ogg bytes behind any audio/* type and saves a download as
# .ogx, whatever the link's download attribute says. Only a type it cannot map
# to an extension keeps the name. The <audio> element sniffs the bytes itself,
# so playback is unaffected.
/nextcloud-conf-2026/voice-is-context--20260918T152131.opus
  Content-Type: application/octet-stream

# /embed/v1/ is the floating contract channel: browsers hold it briefly and then
# revalidate, so a snippet pasted once picks up every compatible release without
# anyone re-pasting it.
/embed/v1/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
