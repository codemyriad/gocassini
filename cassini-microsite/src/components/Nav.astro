---
import '../tailwind.css';
import { Menu, X } from '@lucide/astro';
import logo from '../assets/logo-colour.svg?url';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<header id="site-header" class="fixed w-full top-0 z-50 bg-base-100/60 backdrop-blur-md nav-header">
  <nav class="flex items-center justify-between px-5 py-3">
    <a href={base}>
      <img src={logo} alt="Cassini" class="nav-logo h-[1.6rem] w-auto" />
    </a>

    <!-- Desktop links -->
    <div class="hidden md:flex items-center gap-6">
      <!-- TODO: add nav links -->
      <a href={`${base}changelog`} class="text-sm font-medium text-base-content hover:text-primary transition-colors">Changelog</a>
      <a href={`${base}docs`} class="flex items-center gap-1.5 bg-base-content text-base-100 text-sm font-bold px-3 py-2 rounded-md hover:opacity-80 transition-opacity">
        Docs
      </a>
    </div>

    <!-- Mobile: Docs + hamburger -->
    <div class="flex md:hidden items-center gap-2">
      <a href={`${base}docs`} class="flex items-center gap-1.5 bg-base-content text-base-100 text-sm font-bold px-3 py-2 rounded-md hover:opacity-90 transition-opacity">
        Docs
      </a>
      <button id="nav-toggle" class="flex items-center justify-center p-2 text-base-content rounded-md hover:bg-base-200 transition-colors" aria-label="Toggle menu">
        <span id="nav-icon-open"><Menu size={20} /></span>
        <span id="nav-icon-close" class="hidden"><X size={20} /></span>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile menu -->
<div id="mobile-menu" class="md:hidden fixed left-0 right-0 top-[60px] z-40 flex flex-col px-5 pb-4 gap-1 border-b border-base-300 bg-base-100/60 backdrop-blur-md nav-menu">
  <!-- TODO: add more mobile nav links -->
  <a href={`${base}changelog`} class="text-lg font-medium text-base-content hover:text-primary py-2.5 border-b border-base-300 transition-colors">Changelog</a>
  <a href={`${base}docs`} class="text-lg font-medium text-base-content hover:text-primary py-2.5 transition-colors">Docs</a>
</div>

<style>
  .nav-header {
    background-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transition: background-color 0.4s ease, backdrop-filter 0.4s ease;
  }
  .nav-header.is-scrolled {
    background-color: color-mix(in srgb, var(--color-base-100) 60%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .nav-menu {
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .nav-menu.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
</style>

<script>
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 10);
  }, { passive: true });

  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('is-open');
    menu?.classList.toggle('is-open', !isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
  });
</script>
