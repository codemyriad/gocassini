---
import "../tailwind.css";
import { Menu, X } from "@lucide/astro";
import logo from "../assets/logo-colour.svg?url";
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
---

<header id="site-header" class="fixed w-full top-0 z-50 bg-base-100/60 backdrop-blur-md nav-header">
  <nav class="flex items-center justify-between px-5 py-3">
    <a href={base}>
      <img src={logo} alt="Cassini" class="nav-logo h-[1.6rem] w-auto" />
    </a>

    <!-- Desktop links -->
    <div class="hidden md:flex items-center gap-6">
      <!-- TODO: add nav links -->
      <a href={`${base}changelog`} class="text-sm font-medium text-base-content hover:text-primary transition-colors">Changelog</a>
      <a href="mailto:hello@codemyriad.io?subject=GoCassini%20Support%20Request" class="text-sm font-medium text-base-content hover:text-primary transition-colors">Support</a>
      <a href="https://github.com/codemyriad/gocassini" target="_blank" rel="noopener noreferrer" class="text-base-content/60 hover:text-base-content transition-colors" aria-label="GitHub">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
      </a>
      <div class="flex items-center gap-3">
        <a href={`${base}docs`} class="flex items-center gap-2 bg-base-content text-base-100 text-sm font-bold px-3 py-2 rounded-md hover:opacity-80 transition-opacity">
          Docs
        </a>
        <a href="https://apps.nextcloud.com/apps/gocassini" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-bold px-3 py-2 rounded-md text-black hover:opacity-80 transition-opacity" style="background: linear-gradient(135deg, #0082c9, #1cafff)">
          <img src={`${base}nc-logo.svg`} alt="" class="w-5 h-5 shrink-0" aria-hidden="true" />
          Nextcloud App Store
        </a>
      </div>
    </div>

    <!-- Mobile: GitHub + Docs + hamburger -->
    <div class="flex md:hidden items-center gap-2">
      <a href="https://github.com/codemyriad/gocassini" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center p-2 text-base-content/60 hover:text-base-content transition-colors" aria-label="GitHub">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
      </a>
      <a href={`${base}docs`} class="flex items-center gap-2 bg-base-content text-base-100 text-sm font-bold px-3 py-2 rounded-md hover:opacity-90 transition-opacity">
        Docs
      </a>
      <button id="nav-toggle" class="flex items-center justify-center p-2 text-base-content rounded-md hover:bg-base-200 transition-colors cursor-pointer" aria-label="Toggle menu">
        <span id="nav-icon-open"><Menu size={20} /></span>
        <span id="nav-icon-close" class="hidden"><X size={20} /></span>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile menu -->
<div id="mobile-menu" class="md:hidden fixed left-0 right-0 top-[60px] z-40 flex flex-col px-5 pb-4 gap-1 border-b border-base-300 bg-base-100/60 backdrop-blur-md nav-menu">
  <!-- TODO: add more mobile nav links -->
  <a href={`${base}changelog`} class="text-lg font-medium text-base-content hover:text-primary py-2.5 border-b border-base-300 transition-colors">Changelog</a>
  <a href="mailto:hello@codemyriad.io?subject=GoCassini%20Support%20Request" class="text-lg font-medium text-base-content hover:text-primary py-2.5 transition-colors">Support</a>
  <a href="https://apps.nextcloud.com/apps/gocassini" target="_blank" rel="noopener noreferrer" class="w-full inline-flex items-center justify-center gap-2 text-sm font-bold px-3 py-2.5 mt-1 rounded-md text-black hover:opacity-80 transition-opacity" style="background: linear-gradient(135deg, #0082c9, #1cafff)">
    <img src={`${base}nc-logo.svg`} alt="" class="w-5 h-5 shrink-0" aria-hidden="true" />
    Nextcloud App Store
  </a>
</div>

<style>
  .nav-header {
    background-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transition: background-color 0.4s ease, backdrop-filter 0.4s ease;
  }
  .nav-header.is-scrolled {
    background-color: color-mix(in srgb, var(--color-base-100) 60%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .nav-menu {
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .nav-menu.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
</style>

<script>
  function initNav() {
    const header = document.getElementById("site-header");
    const checkScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 10);
    checkScroll();
    window.addEventListener("scroll", checkScroll, { passive: true });
    window.addEventListener("resize", checkScroll, { passive: true });

    const toggle = document.getElementById("nav-toggle");
    const menu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("nav-icon-open");
    const iconClose = document.getElementById("nav-icon-close");
    toggle?.addEventListener("click", () => {
      const isOpen = menu?.classList.contains("is-open");
      menu?.classList.toggle("is-open", !isOpen);
      iconOpen?.classList.toggle("hidden", !isOpen);
      iconClose?.classList.toggle("hidden", isOpen);
    });
  }

  document.addEventListener("astro:page-load", initNav);
</script>
