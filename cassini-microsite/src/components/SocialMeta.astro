---
// Link-preview metadata (LinkedIn, Mastodon, Slack, iMessage…).
//
// Without og: tags LinkedIn falls back to its own scraping heuristics, which
// picked the FAQ section — previews read "Questions? We've got answers" over a
// stray answer paragraph. Crawlers require absolute URLs here; relative ones
// are dropped silently.
interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = "og-card.png" } = Astro.props;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(base + image, Astro.site);
---
<link rel="canonical" href={canonical} />
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="GoCassini" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="The GoCassini meeting library: a list of recorded meetings beside a speaker-attributed transcript and an audio player." />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
