---
import "../tailwind.css";
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
const year = new Date().getFullYear();

const cmIcon = `<svg width="18" height="14" viewBox="0 0 160 121" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M74.4642 115.541H85.3733V99.1653H74.4642V115.541Z" fill="currentColor"/>
  <path d="M44.4605 5.54444L34.8728 -9.34149e-05L0 60.4998L34.4823 120.322L44.07 114.778L12.7833 60.4998L44.4605 5.54444Z" fill="currentColor"/>
  <path d="M125.127 0.000192144L115.539 5.54472L147.217 60.5001L115.539 115.455L125.127 121L160 60.5001L125.127 0.000192144Z" fill="currentColor"/>
  <path d="M85.3742 6.36844H74.4651V22.7444H85.3742V6.36844Z" fill="currentColor"/>
  <path d="M42.5952 55.4963H26.2316V66.4136H42.5952V55.4963Z" fill="currentColor"/>
  <path d="M86.869 54.5864H73.132H66.1764H64.5455V60.0454V65.5037H66.1764H73.132H86.869H93.8246H95.4546V60.0454V54.5864H93.8246H86.869Z" fill="currentColor"/>
  <path d="M117.918 66.4136H134.281V55.4963H117.918V66.4136Z" fill="currentColor"/>
  <path d="M101.818 60.9548C101.818 48.8959 92.0498 39.1202 80 39.1202C67.9501 39.1202 58.1818 48.8959 58.1818 60.9548C58.1818 73.0137 67.9501 82.7894 80 82.7894V93.7067C61.9252 93.7067 47.2727 79.0431 47.2727 60.9548C47.2727 42.8664 61.9252 28.2029 80 28.2029C98.0747 28.2029 112.727 42.8664 112.727 60.9548C112.727 79.0431 98.0747 93.7067 80 93.7067V82.7894C92.0498 82.7894 101.818 73.0137 101.818 60.9548Z" fill="currentColor"/>
</svg>`;

const globeIcon = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
  <circle cx="12" cy="12" r="10"/>
  <line x1="2" y1="12" x2="22" y2="12"/>
  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
</svg>`;
---

<div class="h-px bg-base-300 w-full"></div>

<footer class="bg-base-100 px-5 py-5 md:py-8 w-full flex flex-col gap-3">
  <!-- Links + copyright -->
  <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
    <a href={`${base}docs`} class="text-sm font-medium text-base-content hover:text-primary transition-colors">Docs</a>
    <a href={`${base}changelog`} class="text-sm font-medium text-base-content hover:text-primary transition-colors">Changelog</a>
    <a href="mailto:hello@codemyriad.io?subject=GoCassini%20Support%20Request" class="text-sm font-medium text-base-content hover:text-primary transition-colors">Support</a>
    <span class="text-sm font-medium text-base-content/30">© {year} Codemyriad</span>
  </div>
  <!-- Badges: mobile only, bottom of footer -->
  <div class="flex md:hidden items-center gap-2">
    <a href="https://codemyriad.io" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-full bg-base-200/80 border border-base-300 text-base-content hover:text-primary transition-colors text-xs font-medium" set:html={cmIcon + "codemyriad.io"} />
    <div class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-full bg-base-200/80 border border-base-300 text-base-content text-xs font-medium" set:html={globeIcon + "Open source"} />
  </div>
</footer>

<!-- Fixed pills: desktop only -->
<div class="hidden md:flex items-center gap-2 fixed bottom-5 md:bottom-7 right-6 z-40">
  <a href="https://codemyriad.io" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-full bg-base-200/80 backdrop-blur-sm border border-base-300 text-base-content hover:text-primary transition-colors text-xs font-medium">
    <Fragment set:html={cmIcon} />
    codemyriad.io
  </a>
  <div class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-full bg-base-200/80 backdrop-blur-sm border border-base-300 text-base-content text-xs font-medium">
    <Fragment set:html={globeIcon} />
    Open source
  </div>
</div>
