---
import "../tailwind.css";
import { ViewTransitions } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { Headset, Box, Users, Mic, ScrollText, Tag, Package } from "@lucide/astro";
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
---

<!DOCTYPE html>
<html lang="en" data-theme="saturn-dark" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GoCassini — Record &amp; Transcribe Nextcloud Talk</title>
  <meta name="description" content="GoCassini records and transcribes Nextcloud Talk meetings on your own server." />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <ViewTransitions />
</head>
<body class="bg-base-100 text-base-content min-h-screen flex flex-col">

  <Nav transition:persist="site-nav" />

  <!-- TODO: replace with official Nextcloud certified app badge once approved -->
  <div id="nc-badge" class="md:hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-40 transition-all duration-500">
    <a href="https://apps.nextcloud.com/apps/gocassini" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 text-sm font-bold px-3 py-2 rounded-md text-black transition-opacity duration-150 hover:opacity-80 active:opacity-70" style="background: linear-gradient(135deg, #0082c9, #1cafff)">
      <img src={`${base}nc-logo.svg`} alt="" class="w-6 h-6 shrink-0" aria-hidden="true" />
      Nextcloud App Store
    </a>
  </div>

  <main class="flex-1 flex flex-col">

    <!-- Hero -->
    <section class="w-full max-w-7xl mx-auto px-5 md:px-10 lg:px-20 pt-28 pb-10 flex flex-col lg:flex-row lg:items-center gap-16 lg:gap-10">

      <!-- Left: headline + CTA -->
      <div class="flex flex-col gap-6 lg:flex-1">
        <h1 class="text-5xl md:text-6xl xl:text-7xl font-bold tracking-tight leading-[0.9]">
          <span class="block text-base-content/40">Record and</span>
          <span class="block text-base-content/70">transcribe</span>
          <span class="block text-base-content">on Nextcloud</span>
        </h1>
        <p class="text-base md:text-lg text-base-content/50 max-w-sm leading-relaxed">
          Your team already owns the infrastructure. Cassini adds meeting transcription to the stack, processed entirely on your sovereign server.
        </p>
        <div class="flex items-center gap-4 pt-1">
          <a href={`${base}docs`} class="btn btn-primary btn-lg">
            Get started
          </a>
          <a href="#transcript-demo" class="text-sm text-base-content/40 hover:text-base-content/70 transition-colors">
            See how it works →
          </a>
        </div>
      </div>

      <!-- Right: screenshot + terminal card -->
      <div class="lg:flex-1 lg:max-w-lg xl:max-w-xl flex flex-col gap-4">
        <!-- Nextcloud meeting screenshot -->
        <div class="rounded-2xl border border-base-300 overflow-hidden aspect-video">
          <img src={`${base}hero-screenshot.webp`} alt="Nextcloud Talk meeting in progress" class="w-full h-full object-cover" />
        </div>

        <div class="terminal-card rounded-2xl border border-base-300 bg-base-200 overflow-hidden shadow-2xl">
          <!-- Window chrome -->
          <div class="flex items-center gap-1.5 px-3 py-2 border-b border-base-300 bg-base-300/30">
            <span class="w-3 h-3 rounded-full bg-base-content/10"></span>
            <span class="w-3 h-3 rounded-full bg-base-content/10"></span>
            <span class="w-3 h-3 rounded-full bg-base-content/10"></span>
            <span class="ml-3 text-xs text-base-content/30 font-mono">cassini</span>
          </div>
          <!-- Terminal body -->
          <div class="px-4 py-3 font-mono text-xs leading-snug flex flex-col gap-1">
            <p class="text-base-content/40"><span class="text-primary/60">~</span> cassini record --room daily-standup</p>
            <p class="text-base-content/40 pl-4">Nextcloud Talk · daily-standup · 5 participants</p>
            <p class="text-base-content mt-1"><span class="text-primary mr-2">●</span>Recording<span class="text-base-content/30"> 00:02:45</span></p>
            <p class="text-base-content"><span class="text-primary/70 mr-2">✓</span>Transcribing<span class="text-base-content/30 ml-2">parakeet-tdt-0.6b-v3 · local</span></p>
            <p class="text-base-content"><span class="text-primary/70 mr-2">✓</span>Packaging</p>
            <p class="text-base-content/60 mt-1">→ daily-standup-2026-07-01.opus<span class="terminal-blink"></span></p>
          </div>
        </div>
      </div>

    </section>

    <!-- Transcript demo -->
    <section id="transcript-demo" class="relative w-full" aria-label="Transcript demo">
      <div class="md:h-[150vh]">
        <div class="md:sticky md:top-0 md:h-screen flex flex-col items-center justify-center overflow-hidden pt-16 pb-24 md:py-0">
          <div class="w-full max-w-7xl mx-auto px-5 md:px-10 lg:px-20 flex flex-col items-center">

          <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-center">

            <!-- Right on desktop, first on mobile: heading + features -->
            <div class="order-1 md:order-2 flex flex-col gap-8">
              <h2 class="text-3xl md:text-4xl font-bold text-base-content">The basics, covered</h2>
              <div class="flex flex-col gap-5">
                <div class="flex items-start gap-4">
                  <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                    <Users size={20} class="text-primary" />
                  </div>
                  <div>
                    <p class="text-lg font-semibold text-base-content">Speaker ID</p>
                    <p class="text-base text-base-content/50">Every line attributed to the right voice, automatically.</p>
                  </div>
                </div>
                <div class="flex items-start gap-4">
                  <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                    <Headset size={20} class="text-primary" />
                  </div>
                  <div>
                    <p class="text-lg font-semibold text-base-content">Group & 1:1 calls</p>
                    <p class="text-base text-base-content/50">Works with any Nextcloud Talk room.</p>
                  </div>
                </div>
                <div class="flex items-start gap-4">
                  <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                    <Box size={20} class="text-primary" />
                  </div>
                  <div>
                    <p class="text-lg font-semibold text-base-content">Built inside Nextcloud</p>
                    <p class="text-base text-base-content/50">Read transcripts and replay audio without leaving Nextcloud.</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Left on desktop, second on mobile: transcript panel -->
            <div class="order-2 md:order-1 w-full relative">
              <!-- Nextcloud tab bar -->
              <div class="rounded-2xl border border-base-300 overflow-hidden shadow-2xl">
              <div class="flex items-center justify-center gap-0 px-2 py-1.5 bg-base-200/25 border-b border-base-content/10 w-full">
                <!-- nc-talk -->
                <button class="nc-tab flex flex-col items-center gap-1 px-3 py-1 text-base-content/40" aria-label="Talk" tabindex="-1">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9.999 1.24875C8.85004 1.24877 7.71233 1.47509 6.65084 1.91481C5.58934 2.35452 4.62485 2.99901 3.81243 3.81148C3.00001 4.62394 2.35557 5.58848 1.9159 6.65001C1.47624 7.71154 1.24997 8.84927 1.25 9.99825C1.25 12.3187 2.17176 14.5441 3.81252 16.1849C5.45327 17.8257 7.67861 18.7475 9.999 18.7475C11.6005 18.7442 13.1703 18.3015 14.5375 17.4675C15.6128 17.8948 18.0214 19.1625 18.5946 18.6149C19.1936 18.0429 17.8914 15.3504 17.5792 14.3499C18.342 13.0263 18.7449 11.5259 18.7479 9.99817C18.7479 7.67779 17.8261 5.45246 16.1854 3.81169C14.5447 2.17092 12.3193 1.24882 9.999 1.24875ZM10 4.57512C11.4388 4.57512 12.8187 5.1467 13.8361 6.16411C14.8534 7.18151 15.425 8.56142 15.425 10.0002C15.4249 11.439 14.8533 12.8188 13.8359 13.8361C12.8185 14.8535 11.4387 15.425 10 15.425C8.56127 15.425 7.18145 14.8535 6.16408 13.8361C5.1467 12.8188 4.5751 11.439 4.575 10.0002C4.575 8.56142 5.14656 7.18151 6.16395 6.16411C7.18133 5.1467 8.5612 4.57512 10 4.57512Z" fill="white"/></svg>
                </button>
                <!-- nc-calendar -->
                <button class="nc-tab flex flex-col items-center gap-1 px-3 py-1 text-base-content/40" aria-label="Calendar" tabindex="-1">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3.87492 18.75C3.39367 18.75 2.98155 18.5785 2.63942 18.2364C2.47377 18.0764 2.34265 17.8841 2.25416 17.6715C2.16568 17.4588 2.12169 17.2303 2.12492 17V4.75C2.12492 4.26875 2.29642 3.85663 2.63942 3.51363C2.79938 3.3482 2.99153 3.21728 3.20401 3.12894C3.4165 3.04061 3.64483 2.99672 3.87492 3H4.74992V1.25H6.49992V3H13.4999V1.25H15.2499V3H16.1249C16.6062 3 17.0183 3.1715 17.3613 3.51363C17.7034 3.85663 17.8749 4.26875 17.8749 4.75V17C17.8781 17.2302 17.8342 17.4586 17.7459 17.6713C17.6575 17.8839 17.5267 18.0762 17.3613 18.2364C17.2011 18.4017 17.0088 18.5326 16.7962 18.6209C16.5836 18.7093 16.3551 18.7532 16.1249 18.75H3.87492ZM3.87492 17H16.1249V8.25H3.87492V17Z" fill="white"/></svg>
                </button>
                <!-- nc-contacts -->
                <button class="nc-tab flex flex-col items-center gap-1 px-3 py-1 text-base-content/40" aria-label="Contacts" tabindex="-1">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><g clip-path="url(#nc-contacts-clip)"><path d="M-0.000244141 16.4206V13.8752C-0.000244141 13.3597 0.132484 12.887 0.397939 12.4542C0.65172 12.0334 1.01744 11.6912 1.45431 11.4661C2.36582 11.0065 3.32651 10.6518 4.31795 10.4088C5.28533 10.1745 6.27717 10.0564 7.27251 10.057C8.27251 10.057 9.25706 10.1742 10.2271 10.4088C11.1971 10.6442 12.1516 10.9961 13.0907 11.4661C13.5298 11.6933 13.8825 12.0233 14.148 12.4542C14.4125 12.887 14.5453 13.3597 14.5453 13.8752V16.4206H-0.000244141ZM16.3634 16.4206V13.6933C16.3634 13.027 16.178 12.387 15.8071 11.7724C15.4353 11.1588 14.9089 10.6324 14.2271 10.1933C15.6587 10.3563 17.0466 10.7881 18.318 11.4661C18.8634 11.7688 19.2798 12.1061 19.568 12.4779C19.8562 12.8488 19.9998 13.2542 19.9998 13.6933V16.4206H16.3634ZM7.27251 9.14787C6.2725 9.14787 5.41614 8.79151 4.70432 8.07969C3.9925 7.36787 3.63613 6.5115 3.63613 5.5115C3.63613 4.51149 3.9925 3.65513 4.70432 2.94331C5.41614 2.23149 6.2725 1.87512 7.27251 1.87512C8.27251 1.87512 9.12887 2.23149 9.84069 2.94331C10.5525 3.65513 10.9089 4.51149 10.9089 5.5115C10.9089 6.5115 10.5525 7.36787 9.84069 8.07969C9.12887 8.79151 8.27251 9.14787 7.27251 9.14787ZM16.3634 5.5115C16.3634 6.5115 16.0071 7.36787 15.2953 8.07969C14.5834 8.79151 13.7271 9.14787 12.7271 9.14787C12.5607 9.14787 12.348 9.12878 12.0907 9.09151C11.8763 9.06198 11.6639 9.02009 11.4543 8.96605C11.8601 8.487 12.1794 7.94097 12.398 7.35241C12.6169 6.76339 12.7283 6.13988 12.7271 5.5115C12.7271 4.87513 12.6171 4.26149 12.398 3.67058C12.1794 3.08202 11.8601 2.53599 11.4543 2.05694C11.6662 1.98149 11.8789 1.9324 12.0907 1.90876C12.3025 1.88603 12.5152 1.87512 12.7271 1.87512C13.7271 1.87512 14.5834 2.23149 15.2953 2.94331C16.0071 3.65513 16.3634 4.51149 16.3634 5.5115Z" fill="white"/></g><defs><clipPath id="nc-contacts-clip"><rect width="20" height="20" fill="white"/></clipPath></defs></svg>
                </button>
                <!-- nc-activity -->
                <button class="nc-tab flex flex-col items-center gap-1 px-3 py-1 text-base-content/40" aria-label="Activity" tabindex="-1">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.25 19.375L7.1875 12.8125H2.5L10.9375 0.625H12.8125L11.875 8.125H17.5L8.125 19.375H6.25Z" fill="white"/></svg>
                </button>
                <!-- nc-files -->
                <button class="nc-tab flex flex-col items-center gap-1 px-3 py-1 text-base-content/40" aria-label="Files" tabindex="-1">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3.5 16C3.09722 16 2.74653 15.8507 2.44792 15.5521C2.14931 15.2535 2 14.9028 2 14.5V5.5C2 5.08333 2.14931 4.72917 2.44792 4.4375C2.74653 4.14583 3.09722 4 3.5 4H8L10 6H16.5C16.9167 6 17.2708 6.14583 17.5625 6.4375C17.8542 6.72917 18 7.08333 18 7.5V14.5C18 14.9028 17.8542 15.2535 17.5625 15.5521C17.2708 15.8507 16.9167 16 16.5 16H3.5Z" fill="white"/></svg>
                </button>
                <!-- nc-cassini (active) -->
                <button class="nc-tab nc-tab-active flex flex-col items-center gap-1 px-3 py-1 relative text-base-content" aria-label="Cassini" tabindex="-1">
                  <svg width="22" height="22" viewBox="0 0 180 180" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M138.25 97.5879C134.82 121.014 114.644 139 90.2657 139C81.3703 139 74.433 137.18 67.2657 133C94.2657 124 115.766 112.5 138.25 97.5879Z" fill="white" fill-opacity="0.6"/><path d="M165.266 52C186.39 51.5506 178.266 65.5 165.266 75.5C162.422 77.6875 158.956 80.0667 154.999 82.5742L154.438 82.9248C146.528 87.9039 136.723 93.3741 126.033 98.8506C121.081 101.387 115.939 103.924 110.708 106.415C108.501 107.466 106.278 108.509 104.046 109.54C102.622 110.198 101.195 110.853 99.7656 111.5C96.9458 112.777 94.08 113.989 91.1895 115.142C90.2297 115.524 89.2674 115.901 88.3027 116.271C87.6569 116.518 87.0098 116.762 86.3623 117.003C84.8195 117.578 83.2726 118.136 81.7246 118.678C76.9192 120.36 72.1032 121.882 67.3652 123.256C65.9608 123.663 64.5633 124.057 63.1748 124.438C61.3061 124.951 59.454 125.441 57.624 125.907C56.7047 126.142 55.7912 126.371 54.8838 126.594C54.8502 126.602 54.8168 126.611 54.7832 126.619C54.3532 126.725 53.9242 126.828 53.4971 126.931C53.1867 127.005 52.8771 127.08 52.5684 127.153C51.698 127.36 50.8343 127.563 49.9776 127.76L46.9043 128.45C38.5062 130.294 30.9082 131.622 24.7656 132.5C7.2658 135 -5.73408 132 4.76564 120C14.31 109.092 26.7657 103 36.7656 99C37.4269 98.7355 38.7656 99.4555 37.7656 101C36.8483 102.417 33.7114 104.6 29.2656 108C16.2984 117.916 36.2657 115 47.7656 112.5C59.2656 110 109.766 95 136.266 77C162.766 59 149.766 59.5 146.266 59.5H134.266C133.766 59.4997 132.933 58.2692 135.766 57C140.189 55.0179 150.94 52.3048 165.266 52Z" fill="white"/><path d="M90.2657 42C117.052 42 138.766 63.7142 138.766 90.5C138.766 91.0386 138.756 91.575 138.738 92.1094C127.033 98.5543 113.467 105.296 99.7657 111.5C85.8954 117.781 70.9287 122.533 57.2325 126.007C47.7188 117.152 41.7657 104.522 41.7657 90.5C41.7657 63.7142 63.4799 42 90.2657 42Z" fill="white" fill-opacity="0.6"/><circle cx="27.7657" cy="84" r="8" fill="white"/></svg>
                  <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-4 h-[2px] rounded-full bg-base-content"></span>
                </button>
              </div>

              <div class="relative bg-base-200">
                <!-- Header -->
                <div class="flex items-center justify-between px-4 py-3 border-b border-base-300">
                  <div>
                    <p class="text-sm font-bold text-base-content">Daily standup</p>
                    <p class="text-xs text-base-content/40 mt-0.5">Tue, 1 Jul 2026 · 3 min · Chris, Silvio, Marco, Ivan, Alex</p>
                  </div>
                  <span class="text-xs text-base-content/30 font-mono tabular-nums demo-timer">0:18</span>
                </div>

                <!-- Transcript segments -->
                <div class="px-4 py-3 flex flex-col gap-2.5">

                  <article class="demo-segment rounded-sm px-1 transition-all duration-300" data-index="0">
                    <div class="flex items-center gap-1 mb-1">
                      <span class="badge badge-md badge-info text-xs px-1.5 font-bold">Chris</span>
                      <span class="badge badge-md text-xs bg-base-300/50 px-1.5 text-base-content/40 tabular-nums">0:00</span>
                    </div>
                    <p class="text-sm leading-relaxed text-base-content/60"><span class="demo-word">Morning</span> <span class="demo-word">everyone.</span> <span class="demo-word">Let's</span> <span class="demo-word">keep</span> <span class="demo-word">it</span> <span class="demo-word">quick</span> <span class="demo-word">today.</span></p>
                  </article>

                  <article class="demo-segment rounded-sm px-1 ring-2 ring-primary ring-offset-2 ring-offset-base-200" data-index="1">
                    <div class="flex items-center gap-1 mb-1">
                      <span class="badge badge-md badge-info text-xs px-1.5 font-bold">Silvio</span>
                      <span class="badge badge-md text-xs bg-base-300/50 px-1.5 text-base-content/40 tabular-nums">0:18</span>
                    </div>
                    <p class="text-sm leading-relaxed text-base-content/60"><span class="demo-word">Auth</span> <span class="demo-word demo-word-active">refactor</span> <span class="demo-word">is</span> <span class="demo-word">done,</span> <span class="demo-word">pushed</span> <span class="demo-word">to</span> <span class="demo-word">staging.</span> <span class="demo-word">Picking</span> <span class="demo-word">up</span> <span class="demo-word">the</span> <span class="demo-word">notification</span> <span class="demo-word">service</span> <span class="demo-word">today.</span></p>
                  </article>

                  <article class="demo-segment rounded-sm px-1 transition-all duration-300" data-index="2">
                    <div class="flex items-center gap-1 mb-1">
                      <span class="badge badge-md badge-info text-xs px-1.5 font-bold">Marco</span>
                      <span class="badge badge-md text-xs bg-base-300/50 px-1.5 text-base-content/40 tabular-nums">0:45</span>
                    </div>
                    <p class="text-sm leading-relaxed text-base-content/60"><span class="demo-word">Found</span> <span class="demo-word">the</span> <span class="demo-word">race</span> <span class="demo-word">condition</span> <span class="demo-word">—</span> <span class="demo-word">fix</span> <span class="demo-word">going</span> <span class="demo-word">up</span> <span class="demo-word">today.</span></p>
                  </article>

                </div>

                <!-- Fade -->
                <div class="pointer-events-none absolute left-0 right-0 h-16" style="bottom: 56px; background: linear-gradient(to bottom, transparent, var(--color-base-200))"></div>

                <!-- Player mockup -->
                <div class="flex items-center gap-3 px-4 py-3 border-t border-base-300 bg-base-200">
                  <button class="w-7 h-7 rounded-full bg-primary flex items-center justify-center shrink-0" aria-hidden="true" tabindex="-1">
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="currentColor" class="text-primary-content ml-0.5">
                      <path d="M2 1.5l6 3.5-6 3.5V1.5z"/>
                    </svg>
                  </button>
                  <div class="flex-1 min-w-0">
                    <div class="h-1 bg-base-300 rounded-full overflow-hidden">
                      <div class="demo-progress h-full bg-primary rounded-full" style="width: 11%"></div>
                    </div>
                    <div class="flex justify-between text-xs text-base-content/30 mt-1 tabular-nums">
                      <span class="demo-elapsed">0:18</span>
                      <span>2:45</span>
                    </div>
                  </div>
                </div>

              </div>
              </div><!-- end outer card wrapper -->
            </div>

          </div>

          </div>
        </div>
      </div>
    </section>

    <!-- Privacy section -->
    <div class="w-full border-t border-base-300/60"></div>
    <section class="bg-base-200 px-5 md:px-10 lg:px-20 pt-32 pb-16 w-full">
      <div class="flex flex-col gap-4 max-w-4xl mx-auto">

        <p class="text-xs font-bold tracking-widest uppercase text-base-content/30">Data privacy</p>

        <!-- Heading -->
        <div class="flex flex-col gap-2">
          <h2 class="text-4xl md:text-5xl font-bold text-base-content">100% local processing</h2>
          <p class="text-2xl md:text-3xl font-normal text-base-content/50">Your data, your rules</p>
        </div>

        <!-- CPU / GPU options -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-10">
          <div class="bg-base-100 rounded-2xl p-8 flex flex-col gap-5">
            <div class="flex items-center justify-between">
              <h3 class="text-3xl font-bold text-base-content">CPU</h3>
              <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded-md bg-secondary/20 text-secondary">sherpa-onnx</span>
            </div>
            <p class="text-base text-base-content/50 leading-relaxed">Runs on your server. No GPU required. Works on any standard Nextcloud setup — audio never leaves your infrastructure.</p>
          </div>
          <div class="bg-base-100 rounded-2xl p-8 flex flex-col gap-5">
            <div class="flex items-center justify-between">
              <h3 class="text-3xl font-bold text-base-content">GPU</h3>
              <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded-md bg-secondary/20 text-secondary">NVIDIA Parakeet</span>
            </div>
