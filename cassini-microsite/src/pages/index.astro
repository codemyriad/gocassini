---
import '../tailwind.css';
import { ViewTransitions } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { Headset, Lock, FileAudio, MonitorPlay, Users, PackagePlus } from '@lucide/astro';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cassini — Record Nextcloud Talk meetings privately</title>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <ViewTransitions />
</head>
<body class="bg-base-100 text-base-content min-h-screen flex flex-col">

  <Nav transition:persist="site-nav" />

  <main class="flex-1 flex flex-col">

    <!-- Hero -->
    <section class="w-full max-w-7xl mx-auto px-5 md:px-10 lg:px-20 pt-28 pb-10 flex flex-col lg:flex-row lg:items-center gap-16 lg:gap-10">

      <!-- Left: headline + CTA -->
      <div class="flex flex-col gap-6 lg:flex-1">
        <h1 class="text-5xl md:text-6xl xl:text-7xl font-bold tracking-tight leading-[1.05]">
          <span class="block text-base-content/30">Record.</span>
          <span class="block text-base-content/60">Transcribe.</span>
          <span class="block text-base-content">100% private.</span>
        </h1>
        <p class="text-base md:text-lg text-base-content/50 max-w-sm leading-relaxed">
          Cassini packages your Nextcloud Talk meetings into a single portable file — processed entirely on your own server.
        </p>
        <div class="flex items-center gap-4 pt-1">
          <a href={`${base}docs`} class="btn btn-primary btn-lg">
            Get started
          </a>
          <a href={`${base}docs/guides/overview`} class="text-sm text-base-content/40 hover:text-base-content/70 transition-colors">
            See how it works →
          </a>
        </div>
      </div>

      <!-- Right: screenshot + terminal card -->
      <div class="lg:flex-1 lg:max-w-lg xl:max-w-xl flex flex-col gap-4">
        <!-- Nextcloud meeting screenshot placeholder -->
        <div class="rounded-2xl border border-base-300 bg-base-200 overflow-hidden aspect-video flex items-center justify-center">
          <p class="text-xs text-base-content/20 font-mono">nextcloud meeting screenshot</p>
        </div>

        <div class="terminal-card rounded-2xl border border-base-300 bg-base-200 overflow-hidden shadow-2xl">
          <!-- Window chrome -->
          <div class="flex items-center gap-1.5 px-3 py-2 border-b border-base-300 bg-base-300/30">
            <span class="w-3 h-3 rounded-full bg-base-content/10"></span>
            <span class="w-3 h-3 rounded-full bg-base-content/10"></span>
            <span class="w-3 h-3 rounded-full bg-base-content/10"></span>
            <span class="ml-3 text-xs text-base-content/30 font-mono">cassini</span>
          </div>
          <!-- Terminal body -->
          <div class="px-4 py-3 font-mono text-xs leading-snug flex flex-col gap-1">
            <p class="text-base-content/40"><span class="text-primary/60">~</span> cassini record --room daily-standup</p>
            <p class="text-base-content/40 pl-4">Nextcloud Talk · daily-standup · 5 participants</p>
            <p class="text-base-content mt-1"><span class="text-primary mr-2">●</span>Recording<span class="terminal-blink text-base-content/30"> 00:42:17</span></p>
            <p class="text-base-content"><span class="text-primary/70 mr-2">✓</span>Transcribing<span class="text-base-content/30 ml-2">whisper-base · local</span></p>
            <p class="text-base-content"><span class="text-primary/70 mr-2">✓</span>Packaging</p>
            <p class="text-base-content/60 mt-1">→ daily-standup-2026-07-01.opus</p>
          </div>
        </div>
      </div>

    </section>

    <!-- Transcript demo -->
    <section id="transcript-demo" class="relative w-full" aria-label="Transcript demo">
      <div class="h-[200vh]">
        <div class="sticky top-0 h-screen flex flex-col items-center justify-center overflow-hidden">
          <div class="w-full max-w-7xl mx-auto px-5 md:px-10 lg:px-20 flex flex-col items-center">

          <div class="w-full flex flex-col items-center gap-8">

            <!-- Top annotation -->
            <div class="demo-annotation self-start max-w-sm" data-at="0.03">
              <p class="text-2xl text-base-content leading-relaxed font-medium">Cassini identifies each participant and attributes every line in the transcript to the right voice.</p>
            </div>

            <!-- Centre: transcript panel -->
            <div class="w-full max-w-xl mx-auto relative">
              <div class="absolute -inset-4 bg-primary/5 rounded-3xl blur-2xl pointer-events-none"></div>

              <div class="relative rounded-2xl border border-base-300 bg-base-200 overflow-hidden shadow-2xl">
                <!-- Header -->
                <div class="flex items-center justify-between px-4 py-3 border-b border-base-300">
                  <div>
                    <p class="text-sm font-bold text-base-content">Daily standup</p>
                    <p class="text-xs text-base-content/40 mt-0.5">Tue, 1 Jul 2026 · 3 min · Chris, Silvio, Marco, Ivan, Alex</p>
                  </div>
                  <span class="text-xs text-base-content/30 font-mono tabular-nums demo-timer">0:00</span>
                </div>

                <!-- Transcript segments -->
                <div class="px-4 py-3 flex flex-col gap-2.5">

                  <article class="demo-segment rounded-sm px-1 transition-all duration-300" data-index="0">
                    <div class="flex items-center gap-1 mb-1">
                      <span class="badge badge-md badge-info text-xs px-1.5 font-bold">Chris</span>
                      <span class="badge badge-md text-xs bg-base-300/50 px-1.5 text-base-content/40 tabular-nums">0:00</span>
                    </div>
                    <p class="text-sm leading-relaxed text-base-content/60"><span class="demo-word">Morning</span> <span class="demo-word">everyone.</span> <span class="demo-word">Let's</span> <span class="demo-word">keep</span> <span class="demo-word">it</span> <span class="demo-word">quick</span> <span class="demo-word">today.</span></p>
                  </article>

                  <article class="demo-segment rounded-sm px-1 transition-all duration-300" data-index="1">
                    <div class="flex items-center gap-1 mb-1">
                      <span class="badge badge-md badge-info text-xs px-1.5 font-bold">Silvio</span>
                      <span class="badge badge-md text-xs bg-base-300/50 px-1.5 text-base-content/40 tabular-nums">0:18</span>
                    </div>
                    <p class="text-sm leading-relaxed text-base-content/60"><span class="demo-word">Auth</span> <span class="demo-word">refactor</span> <span class="demo-word">is</span> <span class="demo-word">done,</span> <span class="demo-word">pushed</span> <span class="demo-word">to</span> <span class="demo-word">staging.</span> <span class="demo-word">Picking</span> <span class="demo-word">up</span> <span class="demo-word">the</span> <span class="demo-word">notification</span> <span class="demo-word">service</span> <span class="demo-word">today.</span></p>
                  </article>

                  <article class="demo-segment rounded-sm px-1 transition-all duration-300" data-index="2">
                    <div class="flex items-center gap-1 mb-1">
                      <span class="badge badge-md badge-info text-xs px-1.5 font-bold">Marco</span>
                      <span class="badge badge-md text-xs bg-base-300/50 px-1.5 text-base-content/40 tabular-nums">0:45</span>
                    </div>
                    <p class="text-sm leading-relaxed text-base-content/60"><span class="demo-word">Found</span> <span class="demo-word">the</span> <span class="demo-word">race</span> <span class="demo-word">condition</span> <span class="demo-word">—</span> <span class="demo-word">fix</span> <span class="demo-word">going</span> <span class="demo-word">up</span> <span class="demo-word">today.</span></p>
                  </article>

                </div>

                <!-- Fade -->
                <div class="pointer-events-none absolute left-0 right-0 h-16" style="bottom: 56px; background: linear-gradient(to bottom, transparent, oklch(14% 0 0))"></div>

                <!-- Player mockup -->
                <div class="flex items-center gap-3 px-4 py-3 border-t border-base-300 bg-base-200">
                  <button class="w-7 h-7 rounded-full bg-primary flex items-center justify-center shrink-0" aria-hidden="true" tabindex="-1">
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="currentColor" class="text-primary-content ml-0.5">
                      <path d="M2 1.5l6 3.5-6 3.5V1.5z"/>
                    </svg>
                  </button>
                  <div class="flex-1 min-w-0">
                    <div class="h-1 bg-base-300 rounded-full overflow-hidden">
                      <div class="demo-progress h-full bg-primary rounded-full" style="width: 0%; transition: width 0.1s linear"></div>
                    </div>
                    <div class="flex justify-between text-xs text-base-content/30 mt-1 tabular-nums">
                      <span class="demo-elapsed">0:00</span>
                      <span>2:45</span>
                    </div>
                  </div>
                </div>

              </div>
            </div>

            <!-- Bottom annotation -->
            <div class="demo-annotation self-end max-w-xs text-left" data-at="0.35">
              <p class="text-2xl text-base-content leading-relaxed font-medium">Read the transcript and replay the audio from inside the Nextcloud app.</p>
            </div>

          </div>

          </div>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="px-5 md:px-10 lg:px-20 py-16 w-full max-w-7xl mx-auto text-center">
      <p class="text-base-content/40 text-xl md:text-2xl">
        Ready to get started?
        <a href={`${base}docs`} class="text-base-content hover:text-primary transition-colors ml-1">Read the docs →</a>
      </p>
    </section>

    <!-- Features -->
    <section class="px-5 md:px-10 lg:px-20 py-12 w-full max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

        <div class="bg-[oklch(20%_0_0)] rounded-2xl p-8 flex flex-col gap-3">
          <Headset size={32} strokeWidth={1.5} class="text-primary" />
          <h3 class="text-lg font-semibold">Group and 1:1 calls</h3>
          <p class="text-sm text-base-content/50 leading-relaxed">
            Works with any Nextcloud Talk room — whether it's a team standup, a client call, or a one-on-one.
          </p>
        </div>

        <div class="bg-[oklch(20%_0_0)] rounded-2xl p-8 flex flex-col gap-3">
          <Lock size={32} strokeWidth={1.5} class="text-primary" />
          <h3 class="text-lg font-semibold">Private by default</h3>
          <p class="text-sm text-base-content/50 leading-relaxed">
            Speech-to-text runs locally using Whisper. Your audio never leaves your infrastructure.
          </p>
        </div>

        <div class="bg-[oklch(20%_0_0)] rounded-2xl p-8 flex flex-col gap-3">
          <FileAudio size={32} strokeWidth={1.5} class="text-primary" />
          <h3 class="text-lg font-semibold">One portable file</h3>
          <p class="text-sm text-base-content/50 leading-relaxed">
            Every recording becomes a single <code class="text-primary bg-base-300 px-1 rounded text-xs">.opus</code> file — audio, transcript, and metadata in one self-contained archive.
          </p>
        </div>

        <div class="bg-[oklch(20%_0_0)] rounded-2xl p-8 flex flex-col gap-3">
          <MonitorPlay size={32} strokeWidth={1.5} class="text-primary" />
          <h3 class="text-lg font-semibold">Built into Nextcloud</h3>
          <p class="text-sm text-base-content/50 leading-relaxed">
            A dedicated tab inside the Nextcloud app lets you watch recordings and read transcriptions without leaving the platform.
          </p>
        </div>

        <div class="bg-[oklch(20%_0_0)] rounded-2xl p-8 flex flex-col gap-3">
          <Users size={32} strokeWidth={1.5} class="text-primary" />
          <h3 class="text-lg font-semibold">Speaker identification</h3>
          <p class="text-sm text-base-content/50 leading-relaxed">
            Cassini identifies each speaker and labels every line — so you always know who said what.
          </p>
        </div>

        <div class="bg-[oklch(20%_0_0)] rounded-2xl p-8 flex flex-col gap-3">
          <PackagePlus size={32} strokeWidth={1.5} class="text-primary" />
          <h3 class="text-lg font-semibold">One install</h3>
          <p class="text-sm text-base-content/50 leading-relaxed">
            Available from the Nextcloud app marketplace. Works immediately with your existing setup — no new infrastructure, no configuration beyond installing the app.
          </p>
        </div>

      </div>
    </section>

    <!-- FAQ -->
    <section class="px-5 md:px-10 lg:px-20 pt-16 pb-32 w-full max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-16">
        <div>
          <h2 class="text-4xl font-bold text-base-content leading-tight">Questions?<br/>We've got answers.</h2>
        </div>
        <div class="md:col-span-2 flex flex-col gap-3">

        <details class="group rounded-2xl border border-base-300/50 bg-[oklch(20%_0_0/0.5)] px-5 py-4">
          <summary class="flex items-center justify-between cursor-pointer list-none text-base font-medium text-base-content select-none">
            Does audio leave my server?
            <svg class="w-4 h-4 text-base-content/40 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6l4 4 4-4"/></svg>
          </summary>
          <p class="mt-3 text-sm text-base-content/50 leading-relaxed">No. Cassini runs Whisper locally on your Nextcloud server. Audio is never sent to a third-party transcription API — everything is processed on your own infrastructure.</p>
        </details>

        <details class="group rounded-2xl border border-base-300/50 bg-[oklch(20%_0_0/0.5)] px-5 py-4">
          <summary class="flex items-center justify-between cursor-pointer list-none text-base font-medium text-base-content select-none">
            Which Nextcloud versions are supported?
            <svg class="w-4 h-4 text-base-content/40 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6l4 4 4-4"/></svg>
          </summary>
          <p class="mt-3 text-sm text-base-content/50 leading-relaxed">Cassini supports Nextcloud 27 and above with Nextcloud Talk enabled. Check the marketplace listing for the exact compatibility matrix.</p>
        </details>

        <details class="group rounded-2xl border border-base-300/50 bg-[oklch(20%_0_0/0.5)] px-5 py-4">
          <summary class="flex items-center justify-between cursor-pointer list-none text-base font-medium text-base-content select-none">
            What languages can it transcribe?
            <svg class="w-4 h-4 text-base-content/40 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6l4 4 4-4"/></svg>
          </summary>
          <p class="mt-3 text-sm text-base-content/50 leading-relaxed">Whisper supports over 90 languages. Cassini will transcribe in whatever language is spoken in the meeting — no configuration needed.</p>
        </details>

        <details class="group rounded-2xl border border-base-300/50 bg-[oklch(20%_0_0/0.5)] px-5 py-4">
          <summary class="flex items-center justify-between cursor-pointer list-none text-base font-medium text-base-content select-none">
            Does it record every call automatically?
            <svg class="w-4 h-4 text-base-content/40 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6l4 4 4-4"/></svg>
          </summary>
          <p class="mt-3 text-sm text-base-content/50 leading-relaxed">Recording is on-demand. A host starts the recording from within the Talk room, giving participants visibility and keeping you in control of which meetings are captured.</p>
        </details>

        <details class="group rounded-2xl border border-base-300/50 bg-[oklch(20%_0_0/0.5)] px-5 py-4">
          <summary class="flex items-center justify-between cursor-pointer list-none text-base font-medium text-base-content select-none">
            Where are recordings stored?
            <svg class="w-4 h-4 text-base-content/40 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6l4 4 4-4"/></svg>
          </summary>
          <p class="mt-3 text-sm text-base-content/50 leading-relaxed">Each recording is saved as a single <code class="text-primary bg-base-300 px-1 rounded text-xs">.opus</code> file in Nextcloud Files, using the same storage and access controls as the rest of your data.</p>
        </details>

        </div>
      </div>
    </section>

  </main>

  <Footer />

</body>
</html>

<script>
  function initTranscriptDemo() {
    const section = document.getElementById('transcript-demo');
    if (!section) return;

    const segments = Array.from(section.querySelectorAll('.demo-segment'));
    const annotations = section.querySelectorAll('.demo-annotation');
    const timer = section.querySelector('.demo-timer');
    const progressBar = section.querySelector('.demo-progress');
    const elapsed = section.querySelector('.demo-elapsed');

    const times = ['0:00', '0:18', '0:45'];
    const totalSec = 165; // 2:45

    function formatTime(sec) {
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      return `${m}:${s.toString().padStart(2, '0')}`;
    }

    // Build proportional scroll ranges based on word count per segment
    // so longer segments get proportionally more scroll space
    const wordCounts = segments.map(seg => seg.querySelectorAll('.demo-word').length);
    const totalWords = wordCounts.reduce((a, b) => a + b, 0);
    const usable = 0.83; // segments use 83% of range
    const startOffset = 0.04;
    // cumulative start positions for each segment
    const segStarts = [];
    const segWidths = [];
    let cursor = startOffset;
    wordCounts.forEach(count => {
      segStarts.push(cursor);
      const w = (count / totalWords) * usable;
      segWidths.push(w);
      cursor += w;
    });

    function clearAll() {
      segments.forEach(seg => {
        seg.classList.remove('ring-2', 'ring-primary', 'ring-offset-2', 'ring-offset-base-200', 'bg-base-100/20');
        seg.querySelectorAll('.demo-word').forEach(w => w.classList.remove('demo-word-active'));
      });
    }

    function update() {
      const rect = section.getBoundingClientRect();
      const scrolled = -rect.top;
      const total = rect.height - window.innerHeight;
      const progress = Math.max(0, Math.min(1, scrolled / total));

      if (progress >= 0.90) { clearAll(); return; }

      // Find active segment
      let activeIndex = -1;
      for (let i = segments.length - 1; i >= 0; i--) {
        if (progress >= segStarts[i]) { activeIndex = i; break; }
      }

      segments.forEach((seg, i) => {
        const isActive = i === activeIndex;
        seg.classList.toggle('ring-2', isActive);
        seg.classList.toggle('ring-primary', isActive);
        seg.classList.toggle('ring-offset-2', isActive);
        seg.classList.toggle('ring-offset-base-200', isActive);

        const words = seg.querySelectorAll('.demo-word');
        if (isActive) {
          const subProgress = Math.max(0, Math.min(1, (progress - segStarts[i]) / segWidths[i]));
          const activeWordIdx = Math.min(words.length - 1, Math.floor(subProgress * words.length));
          words.forEach((w, j) => w.classList.toggle('demo-word-active', j === activeWordIdx));
        } else {
          words.forEach(w => w.classList.remove('demo-word-active'));
        }
      });

      if (timer && activeIndex >= 0) timer.textContent = times[activeIndex] ?? '0:00';
      const audioSec = Math.min(67, (progress / 0.90) * 67);
      if (progressBar) progressBar.style.width = `${(audioSec / totalSec) * 100}%`;
      if (elapsed) elapsed.textContent = formatTime(audioSec);

      annotations.forEach(el => {
        const at = parseFloat(el.dataset.at ?? '0');
        const visible = progress >= at;
        el.style.opacity = visible ? '1' : '0';
        el.style.transform = visible ? 'translateY(0)' : 'translateY(12px)';
      });
    }

    window.addEventListener('scroll', update, { passive: true });
    update();

    return () => window.removeEventListener('scroll', update);
  }

  document.addEventListener('astro:page-load', initTranscriptDemo);
</script>

<style>
  .demo-annotation {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .demo-word {
    transition: color 0.15s ease;
  }
  .demo-word-active {
    background-color: var(--color-primary);
    outline: 1px solid var(--color-primary);
    border-radius: 2px;
  }
  .terminal-blink::after {
    content: '▋';
    animation: blink 1.1s step-end infinite;
    margin-left: 4px;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>
