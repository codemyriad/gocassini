---
// The page behind the QR code on the last slide of the NCC 2026 lightning talk [D-777].
//
// It is an index, not a home: only the talk itself lives here. Everything it points at gets a
// permanent URL elsewhere on the site (see D-776), so after Berlin this page becomes an archive
// of the talk while those pages keep earning traffic.
//
// Rule for the day: nothing may 404. Anything unpublished carries a "not yet published" chip and
// no link, rather than a link that dies in front of someone who just scanned a QR code.
import "../tailwind.css";
import { ViewTransitions } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SocialMeta from "../components/SocialMeta.astro";
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";

const title = "Cassini at Nextcloud Conference 2026";
const description =
  "The talk as a Cassini file — audio, transcript, summary and tags — plus what each way of running it costs.";
---

<!DOCTYPE html>
<html lang="en" data-theme="saturn-dark" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <SocialMeta title={title} description={description} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <ViewTransitions />
</head>
<body class="bg-base-100 text-base-content min-h-screen flex flex-col">

  <Nav transition:persist="site-nav" />

  <main class="page flex-1">

    {/* ===================== Hero ===================== */}
    <header class="talk-hero">
      <h1>
        <span class="dim">Voice is context.</span>
        How Cassini records your meetings into searchable memory.
      </h1>
      <p class="kicker">
        <span class="k-strong">20 Sept 2026</span>
        <span class="k-sep">·</span> Chris De Sousa, Codemyriad
      </p>
      <p class="lede">
        A five-minute lightning talk at the Nextcloud Community Conference in Berlin, on four design
        decisions that have shaped Cassini, a recording backend for Nextcloud Talk.
      </p>
    </header>

    {/* ===================== The talk, as a Cassini file =====================
      TODO(D-775): #cassini-talk is the mount point for the public viewer embed. Once
      /embed/v1/ is published, replace this card's children with:
        <link rel="stylesheet" href="https://gocassini.com/embed/v1/viewer.css" />
        <script src="https://gocassini.com/embed/v1/viewer.js"></script>
      Fallback if the embed is not solid by Friday: the static export
      (`npm run export:meetings -- --rebuild-viewer`) published under this page, which shows
      the summary and transcript but no tags.

      The markup below is a placeholder that mirrors what the embed renders, so the page has
      its real shape before the recording exists.
    */}
    <div class="talk" id="talk">
      <div class="viewer" id="cassini-talk" data-src={`${base}nextcloud-conf-2026/voice-is-context.opus`}>
        <div class="viewer-head">
          <h2 class="viewer-title">Voice is Context.opus</h2>
          <p class="viewer-meta">
            1 speaker · 5:00 · Read the summary, click a tag to jump to a decision, click a word to hear it
          </p>
        </div>

        {/* The tags are the table of contents: one per beat, plus a `decision` mark on each of
             the three decision sentences. Written with `cassini annotate apply` AFTER the final
             file exists — marks bind to the audio digest, so the file must not be re-packed. */}
        <div class="tagbar" aria-label="Tags in the file">
          <span class="tag">capture</span>
          <span class="tag">transcription</span>
          <span class="tag">format</span>
          <span class="tag">intelligence</span>
          <span class="tag decision">decision ×3</span>
        </div>

        <div class="player">
          <div class="track"><span class="handle"></span></div>
          <div class="times">
            <span>0:00 elapsed</span>
            <span>5:00 total</span>
            <span>-5:00 remaining</span>
          </div>
          <div class="controls">
            <span class="play" aria-hidden="true">
              <svg width="11" height="11" viewBox="0 0 10 10" fill="currentColor"><path d="M2 1.5l6 3.5-6 3.5V1.5z"/></svg>
            </span>
            <span class="pill-ghost">Auto-scroll paused</span>
          </div>
        </div>

        <div class="summary">
          <p class="fd-head">Summary · written by the model this deployment runs, from this transcript</p>
          <p class="skel" aria-hidden="true"><i style="width:96%"></i><i style="width:90%"></i><i style="width:58%"></i></p>
        </div>

        <div class="transcript">
          <div class="seg" aria-hidden="true">
            <div class="seg-head"><span class="badge-speaker">Chris De Sousa</span><span class="badge-time">0:00</span></div>
            <p class="skel"><i style="width:94%"></i><i style="width:71%"></i></p>
          </div>
          <div class="seg" aria-hidden="true">
            <div class="seg-head"><span class="badge-speaker">Chris De Sousa</span><span class="badge-time">0:42</span></div>
            <p class="skel"><i style="width:88%"></i><i style="width:96%"></i><i style="width:54%"></i></p>
          </div>
          <p class="transcript-note">
            <span class="chip">not yet published</span>
            The summary, transcript and tags appear here once the talk is recorded.
          </p>
        </div>

        {/* TODO: the recording goes at public/nextcloud-conf-2026/voice-is-context.opus.
             Until it exists the row keeps the chip and no link. When it lands, swap the chip for
             an anchor with class "dl" pointing at that file, carrying its real size in a .size span. */}
        <div class="file-details">
          <div class="fd-row">
            <span>Audio, transcript, summary &amp; tags in one file</span>
            <span class="chip">not yet published</span>
          </div>
          <p class="fd-note">
            Curious about the file format? Read the spec at
            <a href="https://format.gocassini.com" target="_blank" rel="noopener noreferrer">format.gocassini.com</a>
          </p>
        </div>
      </div>
    </div>

    {/* ===================== Transcription and insights ===================== */}
    <section id="control">
      <div class="head">
        <h2>Transcriptions and insights on infrastructure you own</h2>
        <p>Speech-to-text always runs on your host. LLM-powered insights are opt-in.</p>
      </div>

      {/* Slide 29, as a page. One axis down the left: arrow and label above, rail beside,
           arrow and label below. Wide, the axis runs past both panels; narrow, the transcription
           panel sits on its own and the axis runs beside the provider choice only. */}
      <div class="ladder">
        <p class="axis axis-top">
          <span class="arrow" aria-hidden="true">
            <svg width="10" height="15" viewBox="0 0 10 15" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 14V1M1 5l4-4 4 4"/></svg>
          </span>
          <span>Full control <span class="soft">· nothing leaves the building</span></span>
        </p>

        <span class="rail" aria-hidden="true"></span>

        <div class="own">
          <h3>The transcription model runs on CPU or GPU.</h3>
          <p>Cassini picks the build that fits the hardware you give it.<br />Still yours, even if someone else runs the box.</p>
        </div>

        <div class="llm">
          <p class="llm-head">Configure an AI provider, or leave it empty</p>
          <div class="cell cell-none">
            <strong>None</strong>
            <p>The transcript, search and tags are the whole product</p>
          </div>
          <div class="cell cell-run">
            <strong>A LLM model you run</strong>
            <p>An open-weight model on your own Ollama server · nothing leaves</p>
          </div>
          <div class="cell cell-paid">
            <strong>A LLM model you pay for</strong>
            <p>Any OpenAI-compatible endpoint · your meetings leave the building</p>
          </div>
        </div>

        <p class="axis axis-bottom">
          <span class="arrow" aria-hidden="true">
            <svg width="10" height="15" viewBox="0 0 10 15" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 1v13M1 10l4 4 4-4"/></svg>
          </span>
          <span>Full service <span class="soft">· if you’re fine trusting a third party</span></span>
        </p>
      </div>

      {/* TODO(D-779, D-780, D-782): none of these three pages exists yet. Each row is inert
           until its page ships, then it becomes an <a class="row" href="…"> with a "Read →".
           Targets: /research/transcription-cpu-gpu-hosted, /research/summaries-local-vs-hosted,
           /docs/guides/hermes-setup. The two research posts need Silvio's exports. */}
      <div class="deeper">
        <h3 class="rows-head">Go deeper</h3>
        <ul class="rows">
          <li>
            <div class="row pending">
              <span class="row-head">
                <span class="row-kind kind-research">Research</span>
                <span class="chip">not yet published</span>
              </span>
              <h3>Transcription on a CPU, a GPU, or a hosted API</h3>
              <p>
                The same thirty minutes of our own meetings through Parakeet on a CPU, on a GPU, and
                through a hosted API. Memory, speed and price, measured. By Silvio Tomatis.
              </p>
            </div>
          </li>
          <li>
            <div class="row pending">
              <span class="row-head">
                <span class="row-kind kind-research">Research</span>
                <span class="chip">not yet published</span>
              </span>
              <h3>Summaries from a model you run, or one you pay for</h3>
              <p>
                Which local models are good enough for a meeting summary, what a hosted one buys you,
                and what each costs in wall-clock and context. Words where we did not measure.
              </p>
            </div>
          </li>
          <li>
            <div class="row pending">
              <span class="row-head">
                <span class="row-kind kind-case">Case study</span>
                <span class="chip">not yet published</span>
              </span>
              <h3>Hermes across a month of meetings</h3>
              <p>
                Silvio pointed an agent at the CLI with an app password. What he asked, what came back,
                and what it cost to run.
              </p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    {/* ===================== Get Cassini =====================
      TODO: the primary button is Book a demo while the App Store listing is a pre-release in the
      Unstable channel. If 0.2.0 stable ships (D-657), swap btn-primary onto Install. The demo
      link is a mailto until a calendar link exists.
    */}
    <section class="close" id="get">
      <h2>Harness voice, with full privacy</h2>
      <div class="actions">
        <a class="btn-cta ghost" href="https://apps.nextcloud.com/apps/gocassini" target="_blank" rel="noopener noreferrer">Install from the App Store</a>
        <a class="btn-cta primary" href="mailto:hello@codemyriad.io?subject=Book%20a%20Cassini%20demo">Book a demo</a>
      </div>
    </section>

  </main>

  <Footer />

  <style>
    /* Every custom property this page uses is declared on .page rather than :root, so the
       page carries its own ink ramp without touching the theme. The --color-* tokens come
       from daisyUI's saturn-dark, set by data-theme on <html>. */
    .page {
      --ink-70: color-mix(in oklab, var(--color-base-content) 70%, transparent);
      --ink-60: color-mix(in oklab, var(--color-base-content) 60%, transparent);
      --ink-45: color-mix(in oklab, var(--color-base-content) 45%, transparent);
      --ink-35: color-mix(in oklab, var(--color-base-content) 35%, transparent);
      --line: var(--color-base-300);
      --line-soft: color-mix(in oklab, var(--color-base-300) 60%, transparent);
      --mono: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace);

      max-width: 56rem;
      margin-inline: auto;
      width: 100%;
      padding-inline: max(16px, 1.25rem);
      padding-block: 5rem 4rem;
      display: flex;
      flex-direction: column;
      gap: 4.5rem;
      font-size: 1rem;
      line-height: 1.6;
    }
    @media (min-width: 48rem) {
      .page { padding-inline: 2.5rem; }
    }

    .page :is(h1, h2, h3) { margin: 0; text-wrap: balance; }
    .page p { margin: 0; }
    .page :is(ul, ol) { margin: 0; padding: 0; list-style: none; }
    .page a { color: inherit; }
    .page :focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; border-radius: 4px; }

    /* ---------------- Hero ---------------- */
    /* Not .hero — daisyUI ships a .hero component (grid + place-items:center) in the
       shared bundle, and its place-items would centre everything in this column. */
    .talk-hero { display: flex; flex-direction: column; gap: 1.25rem; align-items: flex-start; }
    h1 {
      font-size: clamp(2.25rem, 7vw, 3.25rem);
      line-height: 1.05;
      letter-spacing: -0.03em;
      font-weight: 700;
    }
    h1 .dim { display: block; color: var(--ink-45); }
    .kicker {
      font-family: var(--mono);
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-45);
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.35rem 0.6rem;
    }
    /* The date is the fact a scanner needs, so it carries the weight. */
    .kicker .k-strong { color: var(--color-base-content); font-weight: 600; }
    .kicker .k-sep { color: var(--ink-35); }
    .lede { font-size: 1.05rem; color: var(--ink-60); }

    /* ---------------- The recording ---------------- */
    .talk { display: flex; flex-direction: column; gap: 1rem; }
    .viewer {
      border: 1px solid var(--line);
      border-radius: 1rem;
      background: var(--color-base-200);
      overflow: hidden;
    }
    .viewer-head { padding: 1.35rem 1.25rem 0; display: flex; flex-direction: column; gap: 0.35rem; }
    .viewer-title { font-size: clamp(1.15rem, 2.8vw, 1.4rem); font-weight: 700; letter-spacing: -0.015em; }
    .viewer-meta { font-size: 0.82rem; color: var(--ink-45); }

    .tagbar { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0.9rem 1.25rem 0; }
    .tag {
      font-size: 0.75rem;
      font-weight: 600;
      border-radius: 999px;
      padding: 0.15rem 0.65rem;
      border: 1px solid color-mix(in oklab, var(--color-primary) 40%, transparent);
      color: color-mix(in oklab, var(--color-primary) 85%, var(--color-base-content));
    }
    .tag.decision {
      border-color: color-mix(in oklab, var(--color-secondary) 45%, transparent);
      color: var(--color-secondary);
    }

    .player { padding: 1.1rem 1.25rem 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; }
    .track {
      height: 0.4rem;
      border-radius: 999px;
      background: color-mix(in oklab, var(--color-base-300) 70%, transparent);
      position: relative;
    }
    .track .handle {
      position: absolute;
      left: 0;
      top: 50%;
      width: 0.9rem;
      height: 0.9rem;
      border-radius: 50%;
      background: var(--color-primary);
      transform: translate(-10%, -50%);
    }
    .times {
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
      font-size: 0.72rem;
      color: var(--ink-35);
      font-variant-numeric: tabular-nums;
    }
    .controls { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding-top: 0.35rem; }
    .play {
      width: 2.1rem;
      height: 2.1rem;
      border-radius: 0.45rem;
      background: var(--color-primary);
      color: var(--color-primary-content);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: none;
    }
    .pill-ghost {
      font-size: 0.75rem;
      color: var(--ink-45);
      border: 1px solid var(--line);
      border-radius: var(--radius-field, 0.5rem);
      padding: 0.25rem 0.6rem;
    }

    .summary {
      border-top: 1px solid var(--line-soft);
      padding: 1.15rem 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .transcript {
      border-top: 1px solid var(--line-soft);
      padding: 1.15rem 1.25rem 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }
    .seg { display: flex; flex-direction: column; gap: 0.5rem; }
    .seg-head { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
    .badge-speaker {
      font-size: 0.75rem;
      font-weight: 600;
      border: 1px solid var(--line);
      border-radius: 4px;
      padding: 0.1rem 0.45rem;
    }
    .badge-time {
      font-size: 0.72rem;
      color: var(--ink-45);
      background: color-mix(in oklab, var(--color-base-300) 45%, transparent);
      border-radius: 4px;
      padding: 0.1rem 0.4rem;
      font-variant-numeric: tabular-nums;
    }
    .skel { display: flex; flex-direction: column; gap: 0.5rem; }
    .skel i {
      display: block;
      height: 0.75rem;
      border-radius: 3px;
      background: color-mix(in oklab, var(--color-base-300) 50%, transparent);
    }
    .transcript-note {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
      font-size: 0.85rem;
      color: var(--ink-45);
    }

    /* File details: what the file is on the left, how to take it on the right. */
    .file-details {
      border-top: 1px solid var(--line-soft);
      padding: 1rem 1.25rem 1.15rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .fd-head { font-size: 0.78rem; color: var(--ink-35); }
    .fd-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.4rem 1rem;
      flex-wrap: wrap;
      font-size: 0.9rem;
      color: var(--ink-70);
    }
    .dl { font-weight: 700; color: var(--color-primary); text-decoration: none; white-space: nowrap; }
    .dl .size {
      margin-left: 0.45rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      color: color-mix(in oklab, var(--color-primary) 60%, var(--color-base-content));
    }
    .dl:hover { text-decoration: underline; text-underline-offset: 3px; }
    /* Same size and ink as the line above it, so the two read as one block. */
    .fd-note { font-size: 0.9rem; color: var(--ink-70); }
    .fd-note a {
      color: var(--color-primary);
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-color: color-mix(in oklab, var(--color-primary) 45%, transparent);
    }
    .fd-note a:hover { text-decoration-color: var(--color-primary); }

    .chip {
      font-family: var(--mono);
      font-size: 0.68rem;
      letter-spacing: 0.02em;
      color: var(--ink-45);
      background: color-mix(in oklab, var(--color-base-300) 45%, transparent);
      padding: 0.1rem 0.45rem;
      border-radius: 3px;
      white-space: nowrap;
    }

    /* ---------------- Sections ---------------- */
    section { display: flex; flex-direction: column; gap: 1.5rem; scroll-margin-top: 6rem; }
    .head { display: flex; flex-direction: column; gap: 0.6rem; }
    h2 { font-size: clamp(1.5rem, 3.4vw, 1.95rem); line-height: 1.15; letter-spacing: -0.02em; font-weight: 700; }
    .head p { font-size: 1rem; color: var(--ink-60); }

    /* ---------------- Full control / full service ---------------- */
    .ladder {
      display: grid;
      grid-template-columns: 1.5rem 1fr;
      grid-template-areas:
        "own  own"
        "atop atop"
        "rail llm"
        "abot abot";
      column-gap: 1rem;
      row-gap: 0.9rem;
      align-items: stretch;
    }
    @media (min-width: 46rem) {
      .ladder {
        grid-template-columns: 1.5rem 1fr 1fr;
        grid-template-areas:
          "atop atop atop"
          "rail own  llm"
          "abot abot abot";
      }
    }
    .axis {
      display: flex;
      align-items: center;
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-45);
      line-height: 1.3;
    }
    .axis .arrow {
      width: 1.5rem;
      margin-right: 1rem;
      flex: none;
      display: inline-flex;
      justify-content: center;
      color: var(--ink-60);
    }
    .axis .soft { color: var(--ink-35); text-transform: none; letter-spacing: 0.02em; }
    .axis-top { grid-area: atop; }
    .axis-bottom { grid-area: abot; }
    .rail {
      grid-area: rail;
      justify-self: center;
      width: 1px;
      background: linear-gradient(to bottom, var(--ink-35), var(--line));
    }

    .own {
      grid-area: own;
      background: var(--color-primary);
      color: var(--color-primary-content);
      border-radius: 0.9rem;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0.6rem;
    }
    .own h3 { font-size: 1.05rem; font-weight: 650; letter-spacing: -0.01em; line-height: 1.3; }
    .own p {
      font-size: 0.9rem;
      line-height: 1.5;
      color: color-mix(in oklab, var(--color-primary-content) 78%, transparent);
    }

    .llm { grid-area: llm; display: flex; flex-direction: column; gap: 0.6rem; }
    .llm-head { font-size: 0.95rem; font-weight: 650; color: var(--ink-70); }
    .cell {
      border-radius: 0.75rem;
      padding: 0.9rem 1.1rem;
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      flex: 1;
      justify-content: center;
    }
    .cell strong { font-size: 1.05rem; font-weight: 650; letter-spacing: -0.01em; }
    .cell p { font-family: var(--mono); font-size: 0.72rem; line-height: 1.5; color: var(--ink-45); }
    .cell-none { border: 1px solid var(--line); }
    .cell-none strong { color: var(--ink-70); }
    .cell-run { border: 1px solid color-mix(in oklab, var(--color-primary) 75%, transparent); }
    .cell-paid { border: 1px dashed var(--line); }

    /* ---------------- Go deeper ---------------- */
    .deeper { display: flex; flex-direction: column; gap: 0.9rem; }
    .rows-head { font-size: 1rem; font-weight: 650; letter-spacing: -0.01em; color: var(--ink-70); }
    .rows { display: flex; flex-direction: column; gap: 0.6rem; }
    .row {
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      border: 1px solid var(--line);
      border-radius: 1rem;
      background: var(--color-base-200);
      padding: 1rem 1.25rem;
      text-decoration: none;
    }
    a.row:hover { border-color: color-mix(in oklab, var(--color-primary) 55%, transparent); }
    /* The honest state for a page that does not exist yet: no fill, no link. */
    .row.pending { background: none; border-style: dashed; }
    .row.pending h3 { color: var(--ink-70); }
    /* Kind and destination share the top line, so the link sits on a baseline
       rather than floating against a three-line block. */
    .row-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .row h3 { font-size: 1rem; font-weight: 650; letter-spacing: -0.01em; }
    .row > p { font-size: 0.875rem; line-height: 1.5; color: var(--ink-45); }
    .row .go {
      font-family: var(--mono);
