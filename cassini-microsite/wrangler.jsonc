{
  // Static-assets-only Worker (no server code): `wrangler deploy` uploads the
  // built site in ./dist and serves it. .github/workflows/microsite.yml runs
  // it on microsite or deployment-workflow changes pushed to main. Locally,
  // `npm run build && npx wrangler deploy` in this directory does the same.
  //
  // IMPORTANT: `name` and `account_id` pin the Worker this deploys to. The
  // account id is the Code Myriad account; it is not a secret, and setting it
  // here is what stops wrangler asking which account to use.
  "name": "gocassini",
  "account_id": "4ca1b102baca2e7067daf57e186e20c4",
  "compatibility_date": "2025-07-01",
  "routes": [
    { "pattern": "gocassini.codemyriad.io", "custom_domain": true },
    { "pattern": "gocassini.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    // Serve /docs/ -> docs/index.html. (No custom 404 page in the build yet,
    // so not_found_handling stays at its default "none".)
    "html_handling": "auto-trailing-slash"
  }
}
