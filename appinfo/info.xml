<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
  <id>gocassini</id>
  <name>Cassini</name>
  <summary>Record, transcribe, and publish Nextcloud Talk meetings.</summary>
  <description><![CDATA[Cassini joins a Nextcloud Talk room as a bot, records the call,
transcribes and summarizes it, and publishes a readable static site that any
logged-in user can browse. Recording control and job history live in the
admin-only control panel; the published meeting archive is visible to every
logged-in user.]]></description>
  <version>0.1.0</version>
  <licence>agpl</licence>
  <author>codemyriad</author>
  <namespace>Cassini</namespace>
  <category>integration</category>
  <website>https://github.com/codemyriad/gocassini</website>
  <bugs>https://github.com/codemyriad/gocassini/issues</bugs>
  <repository>https://github.com/codemyriad/gocassini</repository>

  <dependencies>
    <nextcloud min-version="30" max-version="35"/>
  </dependencies>

  <external-app>
    <docker-install>
      <registry>ghcr.io</registry>
      <image>codemyriad/gocassini</image>
      <image-tag>latest</image-tag>
    </docker-install>

    <!--
      Environment variables AppAPI may inject into the ExApp container at
      install time. AppAPI's `app_api:app:register` `env` flag only
      propagates KEYs that are declared here; undeclared keys are
      silently dropped (see ExAppService::getAppInfo around the
      array_key_exists check). Values are filtered out if empty, so a
      missing env value leaves the var unset and the operator falls back
      to its default (e.g. talk_shared_secret_set will be false).
    -->
    <environment-variables>
      <variable>
        <name>CASSINI_TALK_RECORDING_SECRET</name>
        <display-name>Talk recording shared secret</display-name>
        <description>HMAC shared secret used by Nextcloud Talk's recording-backend protocol. The operator verifies HMAC(secret, random + body) on every recording trigger; Talk signs requests with the same value stored in spreed's recording_servers config. Both sides must hold an identical non-empty value or the recording trigger returns 403. Provide at install time via the `env` flag on `app_api:app:register`.</description>
        <default></default>
      </variable>
      <variable>
        <name>CASSINI_TALK_BACKEND_URL</name>
        <display-name>Operator-to-Nextcloud Talk backend URL</display-name>
        <description>Overrides the URL the recorder uses to make OCS callbacks back to Nextcloud (room state checks, started/stopped notifications, recording upload). Nextcloud Talk forwards its own self-perceived URL in the `Talk-Recording-Backend` header, which on container-hosted deployments is often a host-port-forward address (e.g. `http://127.0.0.1:28080`) that the ExApp container cannot dial from its own network namespace. Set this to a URL the ExApp container can actually reach (typically the same URL AppAPI gives via `NEXTCLOUD_URL`). Leave unset on a deployment where Nextcloud's `overwrite.cli.url` already resolves correctly from inside the ExApp container.</description>
        <default></default>
      </variable>
    </environment-variables>

    <routes>
      <!--
        Route URL patterns are interpreted by AppAPI as PCRE expressions
        wrapped with `/.../i` delimiters (see ExAppProxyController.php
        passesExAppProxyRoutesChecks). Two consequences:
          - No leading slash. The proxy strips /apps/app_api/proxy/<appid>/
            before matching, so the path it sees is e.g. "viewer/", not
            "/viewer/".
          - Every internal `/` must be escaped as `\/`. An unescaped `/`
            closes the delimiter and PHP raises "Unknown modifier" errors.
      -->

      <!-- ADMIN: control-panel UI -->
      <route>
        <url>^control-panel\/?$</url>
        <verb>GET</verb>
        <access_level>ADMIN</access_level>
      </route>
      <route>
        <url>^control-panel\/.+$</url>
        <verb>GET,HEAD</verb>
        <access_level>ADMIN</access_level>
      </route>

      <!-- ADMIN: operator JSON API -->
      <route>
        <url>^operator\/jobs\/?$</url>
        <verb>GET,POST</verb>
        <access_level>ADMIN</access_level>
      </route>
      <route>
        <url>^operator\/jobs\/[^\/]+\/?$</url>
        <verb>GET</verb>
        <access_level>ADMIN</access_level>
      </route>
      <route>
        <url>^operator\/jobs\/[^\/]+\/stop\/?$</url>
        <verb>POST</verb>
        <access_level>ADMIN</access_level>
      </route>
      <route>
        <url>^operator\/jobs\/[^\/]+\/rerun\/?$</url>
        <verb>POST</verb>
        <access_level>ADMIN</access_level>
      </route>
      <route>
        <url>^operator\/events\/?$</url>
        <verb>GET</verb>
        <access_level>ADMIN</access_level>
      </route>

      <!-- USER: viewer SPA + published recordings (org-wide archive per D10) -->
      <route>
        <url>^viewer\/?$</url>
        <verb>GET</verb>
        <access_level>USER</access_level>
      </route>
      <route>
        <url>^viewer\/.+$</url>
        <verb>GET,HEAD</verb>
        <access_level>USER</access_level>
      </route>
      <route>
        <url>^published\/.+$</url>
        <verb>GET,HEAD</verb>
        <access_level>USER</access_level>
      </route>

      <!--
        PUBLIC: Talk recording-backend protocol. Lets the "Start recording"
        button in Talk reach Cassini through the AppAPI proxy when Cassini
        is deployed as an ExApp. Authentication is Talk's own HMAC over
        secret + Talk-Recording-Random + request body (verified by the
        operator's talk_backend.go) — independent of any NC session, hence
        PUBLIC at the AppAPI layer. Configure Talk's recording_servers to
        point at ${nc_url}/index.php/apps/app_api/proxy/gocassini and the
        record button works the same way it would against a standalone
        cassini-operator bot.
      -->
      <route>
        <url>^api\/v1\/welcome$</url>
        <verb>GET</verb>
        <access_level>PUBLIC</access_level>
      </route>
      <route>
        <url>^api\/v1\/room\/[^\/]+$</url>
        <verb>POST</verb>
        <access_level>PUBLIC</access_level>
      </route>
    </routes>
  </external-app>
</info>
