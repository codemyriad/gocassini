harness/media/processed/showcase-lantern-festival-v1/*.ivf filter=lfs diff=lfs merge=lfs -text
harness/media/processed/showcase-lantern-festival-v1/*.ogg filter=lfs diff=lfs merge=lfs -text

# Recordings are multi-megabyte binaries; keep them out of the object store.
*.opus filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text

# EXCEPT anything the microsite publishes. cassini-microsite/public/ is served
# verbatim by a Cloudflare-side build this repo does not control, and a build
# that does not run `git lfs pull` checks out a ~130-byte pointer file. It would
# publish that pointer AS the recording, with no error anywhere — the page would
# load and the meeting would simply fail to open. A plain blob costs repository
# size; a pointer costs a broken page nobody is watching.
cassini-microsite/public/**/*.opus -filter -diff -merge -text
