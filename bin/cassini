#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MODULE_DIR="$REPO_ROOT/cassini-go-recorder"
export CASSINI_REPO_ROOT="$REPO_ROOT"

# Build to a stable cache path: the exec below replaces the shell, so an EXIT
# trap can never clean up a mktemp dir. Building to a temp name in the same
# directory and renaming keeps concurrent invocations from tearing the binary
# (rename is atomic; no flock needed, macOS lacks it).
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/cassini/bin"
mkdir -p "$CACHE_DIR"
CASSINI_BIN="$CACHE_DIR/cassini"
TMP_BIN="$CACHE_DIR/.cassini.$$"
trap 'rm -f "$TMP_BIN"' EXIT # only fires if the build fails before the exec

go -C "$MODULE_DIR" build -o "$TMP_BIN" ./cmd/cassini
mv -f "$TMP_BIN" "$CASSINI_BIN"

# The CLI links sherpa-onnx for transcription commands. On Nix, sherpa's
# transitive libstdc++ dependency is not found via the main binary RUNPATH, so
# expose the active C++ compiler runtime before executing the built binary.
append_ld_library_path() {
  local dir="$1"
  if [[ -d "$dir" ]]; then
    case ":${LD_LIBRARY_PATH:-}:" in
      *":$dir:"*) ;;
      *) export LD_LIBRARY_PATH="$dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ;;
    esac
  fi
}

CXX_BIN="${CXX:-}"
if [[ -z "$CXX_BIN" ]]; then
  CXX_BIN="$(go -C "$MODULE_DIR" env CXX 2>/dev/null || true)"
fi
if [[ -n "$CXX_BIN" ]] && command -v "$CXX_BIN" >/dev/null 2>&1; then
  LIBSTDCXX="$("$CXX_BIN" -print-file-name=libstdc++.so.6 2>/dev/null || true)"
  if [[ "$LIBSTDCXX" = /* && -e "$LIBSTDCXX" ]]; then
    append_ld_library_path "$(dirname "$LIBSTDCXX")"
  fi
fi

exec "$CASSINI_BIN" "$@"
