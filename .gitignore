# Test/runtime artifacts
/test/runtime/*
!/test/runtime/.gitkeep
/test/media/processed/*
!/test/media/processed/.gitkeep
/test/media/aligned/*
!/test/media/aligned/.gitkeep
/test/media/raw/*
!/test/media/raw/.gitkeep
/test/media/youtube/*
/test/media/sample.*
/harness/runtime/*
!/harness/runtime/.gitkeep
/harness/media/processed/*
!/harness/media/processed/.gitkeep
# Pinned bot fixture for the Talk-record e2e harness; stored via git-lfs
# (see .gitattributes). Local regenerations under other scenario dirs
# stay ignored.
!/harness/media/processed/showcase-lantern-festival-v1/
/harness/media/aligned/*
!/harness/media/aligned/.gitkeep
/harness/media/raw/*
!/harness/media/raw/.gitkeep
/harness/media/youtube/*
/harness/media/sample.*
/cassini-operator/runtime/*
# Operator runtime state, written beside the sqlite DB — lands in-tree when a
# dev run points DBPath into the source dir
/cassini-operator/internal/operator/settings.json
/cassini-operator/internal/operator/llm-settings.json

# Local recorder artifacts
*.csr
*.crt
*.key
*.pem
*.p12
*.mkv
# Test fixtures (small, committed for deterministic CI)
!/harness/media/parakeet-smoke.mkv
gocassini-*.log
*gocassini*.log

# Release build artifacts (staging trees, tarballs, release notes)
/build/

# Go build output
/cassini-go-recorder/gocassini
/cassini-go-recorder/*.out
/cassini-go-recorder/tmp
# A hand-built CLI lands here: `go build -o bin/cassini ./cmd/cassini` from
# inside the module. The sanctioned wrapper (repo-root bin/cassini) builds into
# $XDG_CACHE_HOME instead, so nothing in normal use writes this path — which is
# exactly why it was never ignored, and how a 14 MB binary reached PR #261.
/cassini-go-recorder/bin/

# Scratch output from manual runs.
#
# The other half of the same PR #261 accident: months-old output of by-hand
# `cassini` runs, sitting untracked in a working tree until a broad `git add`
# during a merge swept it in. `scratch/` anywhere is the convention — put
# throwaway output there and it can never be committed by accident.
#
# scripts/check-added-blobs.sh is the backstop for everything these two rules
# cannot name in advance.
scratch/
/cassini-go-recorder/smoke/

# Python cache
__pycache__/
*.pyc

# JavaScript dependencies
node_modules/
*/node_modules/

# Local developer environment (private, non-committed)
.env
.envrc
.env.local

# Agent setup
#
# NOTE: I've set this up to use symlinks and is set up per-developer basis, see envrc.example for more
CLAUDE.md
AGENTS.md

# Private local media captures
/media/
/cassini-viewer/exports/viewer-demo/
bin/cassini-bin

# Vite temp artefacts
*/.vite/*
.gstack/

# The search index is generated. A stray one was committed once, when a zero
# Config resolved its path to the source directory (see searchStorePath).
search.sqlite3
search.sqlite3-wal
search.sqlite3-shm
