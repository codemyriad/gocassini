general: {
  debug_level = 4
  admin_secret = "01e2fcd0d226d7f4cf34a8a61397f110693f05042e57ab68e94f8476a4b8f22a"
  plugins_folder = "/usr/local/lib/janus/plugins"
  transports_folder = "/usr/local/lib/janus/transports"
  events_folder = "/usr/local/lib/janus/events"
}

nat: {
  # Local harness default. For remote access set this to your reachable host IP.
  # Advertised to peers outside the compose network (host browsers, bots, an
  # operator on --network host), who reach the published RTP range there.
  nat_1_1_mapping = "127.0.0.1"
  # Keep the container's own address in the candidate list too: peers on the
  # compose network (the installed ExApp) reach Janus directly through it,
  # while 127.0.0.1 would be their own loopback.
  keep_private_host = true
}

media: {
  rtp_port_range = "20000-20100"
}

admin: {
  admin_port = 17088
  admin_secret = "01e2fcd0d226d7f4cf34a8a61397f110693f05042e57ab68e94f8476a4b8f22a"
}
