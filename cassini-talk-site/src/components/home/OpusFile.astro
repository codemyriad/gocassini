---
import { styler } from "../../demos/bind";
import { file, fileBars, fileLines, fileChips } from "../../demos/file";

const b = file(0, true);
const st = styler(b);
const EASE = "cubic-bezier(0.32, 0.72, 0, 1)";
const linkCls = "text-base-content hover:text-primary underline underline-offset-4 decoration-base-content/30 hover:decoration-primary transition-colors";
---

<section class="w-full max-w-7xl mx-auto px-5 md:px-10 lg:px-20 pt-16 pb-16">
  <div class="file-split">
    <div class="file-copy flex flex-col gap-4" data-reveal>
      <h2 class="text-4xl md:text-5xl font-bold text-base-content" style="line-height: 1.05">One file.<br />Everything inside.</h2>
      <p class="text-lg text-base-content/60 text-balance" style="max-width: 40rem">Any audio player plays it. Cassini.talk opens it on every platform, and so does <a href="https://gocassini.com" class={linkCls}>Cassini for Nextcloud</a>. An open specification at <a href="https://format.gocassini.com" class={linkCls}>format.gocassini.com</a>.</p>
    </div>
    <div class="w-full flex flex-col" style="max-width: 36rem; gap: 12px; justify-self: center" role="img" aria-label="weekly-planning-call.opus opening into its audio, transcript and speakers, playing back together" data-demo="file">
      <div class="relative flex items-center gap-3 rounded-xl border border-base-300 bg-base-200 px-4" style="height: 48px; z-index: 1"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-base-content shrink-0"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"></path><path d="M12 22V12"></path><polyline points="3.29 7 12 12 20.71 7"></polyline><path d="m7.5 4.27 9 5.15"></path></svg><span class="text-sm font-mono text-base-content">weekly-planning-call.opus</span></div>
      <div class="relative flex flex-col" style="gap: 12px; margin-left: 23px; padding-left: 20px">
        <span class="absolute bg-base-300" style="left: 0; top: -12px; bottom: 66px; width: 1px" aria-hidden="true"></span>
        <div class="relative rounded-xl border border-base-300 bg-base-200 p-4 flex flex-col gap-3">
          <span class="ft-tick" aria-hidden="true"></span>
          <p class="flex items-center gap-2 text-sm"><span class="flex items-center"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-base-content shrink-0"><path d="M12 19v3"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><rect x="9" y="2" width="6" height="13" rx="3"></rect></svg></span><span class="font-semibold text-base-content">Audio</span><span class="text-xs text-base-content/60">Opus, plays anywhere</span></p>
          <div class="relative flex items-center justify-between" style="height: 32px" aria-hidden="true">
            {fileBars.map((bar, j) => (
              <span class="rounded-full shrink-0" data-k={"fb" + j} style={st("fb" + j, `width: 3px; height: ${bar.h}px; background: ${bar.c}; transition: opacity 0.25s ease`)}></span>
            ))}
            <div class="absolute inset-0" data-k="fph" style={st("fph", "pointer-events: none")}><span class="absolute rounded-full bg-base-content" style="right: -1px; top: -4px; bottom: -4px; width: 2px"></span></div>
          </div>
        </div>
        <div class="relative rounded-xl border border-base-300 bg-base-200 p-4 flex flex-col gap-3">
          <span class="ft-tick" aria-hidden="true"></span>
          <p class="flex items-center gap-2 text-sm"><span class="flex items-center"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-base-content shrink-0"><path d="M15 12h-5"></path><path d="M15 8h-5"></path><path d="M19 17V5a2 2 0 0 0-2-2H4"></path><path d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3"></path></svg></span><span class="font-semibold text-base-content">Transcript</span><span class="text-xs text-base-content/60">Word-timed, with versions</span></p>
          <div class="ft-line relative text-sm">
            {fileLines.map((ln, i) => (
              <p class="absolute inset-0 leading-relaxed" data-k={"fl" + i} style={st("fl" + i, `transition: opacity 0.4s ease, transform 0.6s ${EASE}, filter 0.4s ease`)}><span class="font-semibold" style={`color: ${ln.c}; margin-right: 0.6em`}>{ln.who}</span>{ln.words.map((w, j) => <span data-k={`fw${i}_${j}`} style={st(`fw${i}_${j}`, "transition: color 0.25s ease")}>{w + " "}</span>)}</p>
            ))}
          </div>
        </div>
        <div class="relative rounded-xl border border-base-300 bg-base-200 p-4 flex flex-col gap-3">
          <span class="ft-tick" aria-hidden="true"></span>
          <p class="flex items-center gap-2 text-sm"><span class="flex items-center"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-base-content shrink-0"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></span><span class="font-semibold text-base-content">Speakers</span><span class="text-xs text-base-content/60">The names you gave them</span></p>
          <div class="flex flex-wrap items-center gap-2" style="min-height: 28px">
            {fileChips.map((c, i) => (
              <span class="inline-flex items-center gap-2 rounded-full border px-3 text-xs font-medium text-base-content" data-k={"fc" + i} style={st("fc" + i, "height: 28px; transition: border-color 0.3s ease, background-color 0.3s ease")}><span class="block rounded-full" style={`width: 6px; height: 6px; background: ${c.dot}`}></span>{c.name}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
