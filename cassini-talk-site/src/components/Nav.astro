---
import SaturnMark from "./SaturnMark.astro";
import { href } from "../lib/paths";

---

<header id="site-header" class="site-nav fixed w-full top-0 z-50 bg-base-100/60 backdrop-blur-md nav-header">
  <nav class="flex items-center justify-between px-5 py-3" aria-label="Main">
    <a href={href()} class="flex items-center gap-2 text-base-content">
      <SaturnMark detail="nav" style="display: block; height: 1.6rem; width: 2.4533rem" />
      <span class="text-lg font-medium">cassini.talk</span>
    </a>
    <div class="hidden md:flex items-center gap-6">
      <a href={href("download#source")} class="text-sm font-medium text-base-content hover:text-primary transition-colors">Source code</a>
      <a href={href("help")} class="text-sm font-medium text-base-content hover:text-primary transition-colors">Help</a>
      <a href={href("download")} class="flex items-center gap-2 bg-base-content text-base-100 text-sm font-bold px-3 py-2 rounded-md hover:opacity-80 transition-opacity">Download</a>
    </div>
    <div class="flex md:hidden items-center gap-2">
      <a href={href("help")} class="flex items-center p-2 text-sm font-medium text-base-content hover:text-primary transition-colors">Help</a>
      <a href={href("download")} class="flex items-center gap-2 bg-base-content text-base-100 text-sm font-bold px-3 py-2 rounded-md hover:opacity-90 transition-opacity">Download</a>
    </div>
  </nav>
</header>

<style>
  .nav-header {
    background-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transition: background-color 0.4s ease, backdrop-filter 0.4s ease;
  }
  .nav-header.is-scrolled {
    background-color: color-mix(in srgb, var(--color-base-100) 60%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const scroller = document.querySelector("[data-scroll-root]") ?? window;
  const top = () => (scroller instanceof Window ? scroller.scrollY : (scroller as HTMLElement).scrollTop);
  const check = () => header?.classList.toggle("is-scrolled", top() > 10);
  check();
  scroller.addEventListener("scroll", check, { passive: true });
</script>
