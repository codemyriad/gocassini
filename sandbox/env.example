# Copy to sandbox/.env on the AIO sandbox host and adjust for that VPS.
# Consumed by sandbox/wire-cassini.sh. All values have sane defaults; you only
# need this file to override them.

# Public URL of the AIO Nextcloud (what browsers and Talk use).
SANDBOX_DOMAIN=demo.nextcloud.codemyriad.io
SANDBOX_SCHEME=https

# Where Cassini comes from:
#   store -> latest published release from the Nextcloud App Store (default)
#   image -> a specific container image (also settable with --image)
CASSINI_INSTALL_SOURCE=store
# CASSINI_EXAPP_IMAGE=ghcr.io/codemyriad/gocassini:latest

# AppAPI update channel. `beta` accepts pre-release (alpha/beta/rc) ExApps so the
# sandbox can install the newest Cassini alpha.
SANDBOX_UPDATE_CHANNEL=beta

# Admin password to reconcile on the AIO instance. In CI this is injected from
# the Sandbox environment secret of the same name; leave unset to keep AIO's
# generated password.
# SANDBOX_NC_ADMIN_PASSWORD=

# Persistent state dir for the HaRP shared key (never the repo). The Talk
# recording secret is self-generated by Cassini on the ExApp volume (D-447).
# Defaults to the shared /opt/cassini-aio; override only for a non-standard host.
# CASSINI_AIO_STATE=/opt/cassini-aio

# Override AIO container/network names only for a non-default AIO install.
# AIO_NEXTCLOUD_CONTAINER=nextcloud-aio-nextcloud
# AIO_TALK_CONTAINER=nextcloud-aio-talk
# AIO_NETWORK=nextcloud-aio
