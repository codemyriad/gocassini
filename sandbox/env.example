# Copy to sandbox/.env on the sandbox host and adjust for that VPS.

# Compose project name. Changing this creates an independent stack.
PROJECT_NAME=cassini-sandbox

# Public URL for the Nextcloud sandbox. Put TLS in front of NEXTCLOUD_HOST_PORT
# with the host reverse proxy of your choice.
SANDBOX_DOMAIN=cassini-sandbox.example.com
SANDBOX_SCHEME=https
NEXTCLOUD_HOST_PORT=28080
# Sandbox tracks latest Nextcloud by default. Pin this only when debugging a
# version-specific issue, for example nextcloud:34.0.0.
NEXTCLOUD_IMAGE=nextcloud:latest

# Use "default" for ExApp/AppAPI demos only, or "full" for Talk recording.
SPREED_PROFILE=full

# Cassini ExApp image to register with AppAPI.
CASSINI_EXAPP_IMAGE=ghcr.io/codemyriad/gocassini:latest

# Demo-only workaround for embedding/proxying the current Cassini web UIs
# through AppAPI. This modifies AppAPI's signed ExAppProxyController.php and
# makes Nextcloud report an app_api integrity warning. Set to false for a
# production-like sandbox.
SANDBOX_PATCH_APPAPI_CSP=true

# Nextcloud demo accounts.
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me
SANDBOX_USER=alice
SANDBOX_USER_PASSWORD=change-me-too

# Talk/signaling/TURN. For full live Talk demos, expose the signaling server
# through TLS and set SANDBOX_SIGNALING_URL to that public URL.
SANDBOX_SIGNALING_URL=https://cassini-sandbox.example.com/spreed
SANDBOX_TURN_HOST=cassini-sandbox.example.com
SANDBOX_TURN_EXTERNAL_IP=
# Optional. Defaults to SANDBOX_TURN_EXTERNAL_IP, then SANDBOX_TURN_HOST.
# For a public VPS, prefer the public IPv4 address so Janus advertises
# reachable ICE candidates to browsers.
SANDBOX_JANUS_EXTERNAL_IP=
# Optional. Leave unset to auto-generate once and persist in
# sandbox/runtime/secrets.env across normal updates.
# SIGNALING_SHARED_SECRET=
# SIGNALING_INTERNAL_SECRET=
# TURN_SHARED_SECRET=
# CASSINI_TALK_RECORDING_SECRET=
