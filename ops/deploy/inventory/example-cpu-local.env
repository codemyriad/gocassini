# Inventory: a CPU deployment whose ExApp container runs on the Nextcloud host.
#
# This file exists to make one point concrete: it is the SAME deploy, and the
# same script, as prod-cloud-codemyriad.env. Diff the two. The delta is the
# daemon (which encapsulates where the container runs) and one line,
# CASSINI_COMPUTE_DEVICE. There is no CPU script and no GPU script.
#
# This is also, roughly, what cloud.codemyriad.io looked like before the
# 2026-07-30 migration to the george GPU node.

CASSINI_DEPLOY_NAME="example-cpu-local"

CASSINI_NC_URL="https://cloud.example.com"
CASSINI_NC_SSH="cloud.example.com"
CASSINI_NC_CONTAINER="nextcloud-aio-nextcloud"

CASSINI_APP_ID="gocassini"
CASSINI_IMAGE_REPO="ghcr.io/codemyriad/gocassini"

# A local HaRP daemon: same daemon type, no FRP tunnel to a remote engine.
# (The deprecated docker_aio Docker Socket Proxy daemon also works today but is
# scheduled for removal in Nextcloud 35 — do not start new installs on it.)
CASSINI_DAEMON="harp_local"
CASSINI_DAEMON_DISPLAY="HaRP (local)"
CASSINI_DAEMON_DEPLOY_ID="docker-install"
CASSINI_DAEMON_PROTOCOL="http"
CASSINI_DAEMON_HOST="appapi-harp:8780"
CASSINI_DAEMON_NET="nextcloud-aio"
CASSINI_DAEMON_HARP="1"
CASSINI_DAEMON_FRP_ADDRESS="appapi-harp:8782"
CASSINI_DAEMON_DOCKER_SOCKET_PORT=""

CASSINI_COMPUTE_DEVICE="cpu"

# The container is on the Nextcloud host here, so no second hop.
CASSINI_IMAGE_INSPECT_CMD="ssh -o BatchMode=yes cloud.example.com \"docker inspect nc_app_gocassini --format '{{.Config.Image}}'\""

CASSINI_SECRET_CMD_RECORDING="docker exec --user www-data nextcloud-aio-nextcloud php occ config:app:get spreed recording_servers | python3 -c 'import sys,json;print(json.load(sys.stdin)[\"secret\"])'"
CASSINI_SECRET_CMD_SIGNALING="sed -nE 's/^[[:space:]]*internalsecret[[:space:]]*=[[:space:]]*//p' /opt/hpb/signaling.conf | head -1"
