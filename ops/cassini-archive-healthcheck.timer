# Twice-daily watchdog over the Cassini meeting archive.
#
# 07:30 — before the working day, so a stopped recorder is noticed before the
#         morning standup rather than after it.
# 19:30 — after the working day, so a failed 13:40 ingest is noticed the same
#         evening.
#
# Neither slot collides with the 03:30-03:50 backup window, the monthly 02:00
# btrfs scrub, the 05:20/13:40/21:40 ingest passes, or the 22:50 snapshot.
#
# Worst-case detection latency for a silently stopped ingest is therefore
# MAX_RUN_AGE_S (30 h) plus at most 12 h — under two days, on-host, with no
# dependency on the R2 heartbeat or on anyone logging in.

[Unit]
Description=Twice-daily freshness and completeness assertions on the Cassini archive
Documentation=https://github.com/codemyriad/gocassini/blob/main/docs/meeting-archive.md

[Timer]
OnCalendar=*-*-* 07:30:00
OnCalendar=*-*-* 19:30:00
RandomizedDelaySec=5m
Persistent=true
AccuracySec=1m
Unit=cassini-archive-healthcheck.service

[Install]
WantedBy=timers.target
