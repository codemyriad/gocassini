# OnFailure= handler for every Cassini archive unit.
#
# george has NO mail (postfix is loopback-only with no relayhost), NO metrics
# exporter and NO messaging credentials, and before this change it had no
# OnFailure= anywhere at all. So this handler is built out of what actually
# works on this host:
#
#   1. a daemon.crit journal record, tagged cassini-archive, with the failing
#      unit, its Result=, its exit status and the tail of its own journal;
#   2. a DURABLE marker at /var/lib/cassini-archive/ALARM plus a full-detail
#      file under /var/lib/cassini-archive/alarms/. The ingest refuses to
#      report green while that marker exists, and clearing it is an explicit
#      human act (`cassini-archive-sync --apply --ack`), so a later successful
#      run cannot erase the evidence;
#   3. the same failure stamped into state/health.json and into the off-host
#      heartbeat inside the ExApp volume, so the R2 copy carries `failed`
#      within hours instead of waiting 30 h for the freshness check to notice;
#   4. a wall broadcast, and /etc/update-motd.d/98-cassini-archive prints the
#      marker on every SSH login;
#   5. an OPTIONAL notifier — ALERT_WEBHOOK_URL or ALERT_COMMAND, supplied in
#      /etc/default/cassini-archive-alert. When neither is set the handler logs
#      `notifier=unconfigured` and still succeeds: an unconfigured notifier must
#      never turn into a failing unit.
#
# Usage from a watched unit:  OnFailure=cassini-archive-alert@%n.service
# %i is then the failing unit name, e.g. cassini-archive-sync.service.

[Unit]
Description=Cassini archive failure alert for %i
Documentation=https://github.com/codemyriad/gocassini/blob/main/docs/meeting-archive.md
# No OnFailure= here: an alert handler that alerts about itself loops.

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/cassini-archive
EnvironmentFile=-/etc/default/cassini-archive-alert
ExecStart=/usr/local/sbin/cassini-archive-alert %i
# A hung webhook must not wedge the alert path.
TimeoutStartSec=2m

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelLogs=yes
# Writes the marker, the health stamp and the heartbeat — nothing else.
#
# EVERY path here is optional (leading dash) and the marker directory is a
# StateDirectory. This is the one unit that must be able to start when the rest
# of the world is broken: a missing ReadWritePaths= entry is a unit START
# failure (226/NAMESPACE), and the two /mnt/data paths below vanish exactly when
# something has gone wrong — /mnt/data unmounted (fstab carries nofail), or the
# ExApp volume recreated by a reinstall. This handler deliberately has no
# OnFailure= of its own, so if it cannot start, NOTHING is reported: no marker,
# no daemon.crit record, no wall, no motd banner. A degraded alert that still
# reaches the journal and the terminal beats a perfect one that never runs.
StateDirectory=cassini-archive
StateDirectoryMode=0750
ReadWritePaths=-/mnt/data/cassini-archive
ReadWritePaths=-/mnt/data/cassini-exapp/docker/volumes/nc_app_gocassini_data/_data/operator/backups
