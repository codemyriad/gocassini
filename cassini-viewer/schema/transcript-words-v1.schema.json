{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/transcript.words.v1.schema.json",
  "title": "Transcript Words v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "media", "speakers", "segments"],
  "properties": {
    "version": {
      "const": "transcript.words.v1"
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "durationMs"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "speakers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      }
    }
  },
  "$defs": {
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "startMs", "endMs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "startMs": { "type": "integer", "minimum": 0 },
        "endMs": { "type": "integer", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startMs", "endMs", "text", "words"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "speaker": { "type": "string", "minLength": 1 },
        "startMs": { "type": "integer", "minimum": 0 },
        "endMs": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" },
        "words": {
          "type": "array",
          "items": { "$ref": "#/$defs/word" }
        }
      }
    }
  }
}
